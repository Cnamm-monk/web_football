@{
    ViewData["Title"] = "Yêu cầu đổi khung giờ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var don = ViewBag.DatSan as Web_Stadium.EFCore.DatSan;
    var san = ViewBag.SanBong as Web_Stadium.EFCore.SanBong;
    var khungGioList = ViewBag.KhungGioList as List<Web_Stadium.EFCore.KhungGio> ?? new();
}

@section Styles {
<style>
.ycg-wrap { max-width:680px; margin:100px auto 60px; padding:0 16px; }
.ycg-card { background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:28px; margin-bottom:20px; }
.ycg-title { font-size:1.3rem; font-weight:700; color:var(--text); margin-bottom:6px; }
.ycg-sub { font-size:.85rem; color:var(--muted); margin-bottom:20px; }
.info-row { display:flex; gap:8px; align-items:center; padding:10px 0; border-bottom:1px solid var(--border); font-size:.9rem; }
.info-row:last-child { border-bottom:none; }
.info-lbl { color:var(--muted); width:110px; flex-shrink:0; }
.info-val { color:var(--text); font-weight:600; }
.field-label { font-size:.82rem; color:var(--muted); margin-bottom:6px; font-weight:500; }
.ycg-select { width:100%; padding:10px 14px; background:var(--bg3); border:1px solid var(--border);
              border-radius:10px; color:var(--text); font-size:.9rem; cursor:pointer; }
.ycg-select:focus { outline:none; border-color:var(--green); }
.ycg-textarea { width:100%; padding:12px 14px; background:var(--bg3); border:1px solid var(--border);
                border-radius:10px; color:var(--text); font-size:.9rem; resize:vertical; min-height:100px; }
.ycg-textarea:focus { outline:none; border-color:var(--green); }
.char-count { font-size:.75rem; color:var(--muted); text-align:right; margin-top:4px; }
.char-count.ok { color:var(--green); }
.ycg-btn { display:block; width:100%; padding:14px; background:var(--green); color:#000;
           font-weight:700; font-size:.95rem; border:none; border-radius:12px; cursor:pointer; margin-top:20px; }
.ycg-btn:hover { opacity:.9; }
.kg-item { padding:10px 14px; background:var(--bg3); border:1px solid var(--border);
           border-radius:10px; cursor:pointer; margin-bottom:8px; transition:.15s; }
.kg-item:hover, .kg-item.selected { border-color:var(--green); background:rgba(30,215,96,.08); }
.kg-item input[type=radio] { display:none; }
.kg-time { font-weight:700; color:var(--text); }
.kg-gia { color:var(--green); font-size:.85rem; margin-top:2px; }
.date-input { padding:10px 14px; background:var(--bg3); border:1px solid var(--border);
              border-radius:10px; color:var(--text); font-size:.9rem; cursor:pointer; }
.date-input:focus { outline:none; border-color:var(--green); }
</style>
}

<div class="ycg-wrap">
    @if (TempData["Error"] != null)
    {
        <div style="background:rgba(239,68,68,.1);border:1px solid #ef4444;border-radius:10px;
                    padding:12px 16px;margin-bottom:16px;color:#ef4444;font-size:.9rem;">
            ⚠️ @TempData["Error"]
        </div>
    }

    <!-- Đơn hiện tại -->
    <div class="ycg-card">
        <div class="ycg-title">🔄 Yêu cầu đổi khung giờ</div>
        <div class="ycg-sub">Gửi yêu cầu đổi sang khung giờ khác — Staff và Owner sẽ xem xét.</div>

        <div class="info-row"><span class="info-lbl">🏟 Sân</span><span class="info-val">@san?.TenSan</span></div>
        <div class="info-row"><span class="info-lbl">📅 Ngày hiện tại</span><span class="info-val">@don?.NgayThiDau.ToString("dd/MM/yyyy")</span></div>
        <div class="info-row">
            <span class="info-lbl">⏰ Giờ hiện tại</span>
            <span class="info-val">
                @(don?.KhungGio != null
                    ? $"{don.KhungGio.GioBatDau:hh\\:mm} – {don.KhungGio.GioKetThuc:hh\\:mm}"
                    : "N/A")
            </span>
        </div>
        <div class="info-row"><span class="info-lbl">🎫 Mã đơn</span><span class="info-val" style="font-family:monospace;color:var(--green)">@don?.MaXacNhan</span></div>
    </div>

    <!-- Form yêu cầu -->
    <div class="ycg-card">
        <form method="post" action="/Booking/GuiYeuCauDoiGio" id="formYC">
            @Html.AntiForgeryToken()
            <input type="hidden" name="datSanId" value="@don?.Id" />
            <input type="hidden" name="khungGioMoiId" id="khungGioMoiInput" value="" />

            <!-- Chọn ngày mới -->
            <div style="margin-bottom:20px;">
                <div class="field-label">📅 Chọn ngày mới</div>
                <input type="date" name="ngayMoiStr" id="ngayMoiInput"
                       class="date-input"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")"
                       value="@don?.NgayThiDau.ToString("yyyy-MM-dd")"
                       onchange="loadKhungGio()"
                       style="width:100%;" />
            </div>

            <!-- Danh sách khung giờ -->
            <div style="margin-bottom:20px;">
                <div class="field-label">⏰ Chọn khung giờ mới (còn trống)</div>
                <div id="khungGioContainer">
                    @if (!khungGioList.Any())
                    {
                        <div style="color:var(--muted);font-size:.88rem;padding:12px 0;">
                            Không có khung giờ trống cho ngày này.
                        </div>
                    }
                    else
                    {
                        foreach (var kg in khungGioList)
                        {
                            <label class="kg-item" onclick="chonKhungGio(this, @kg.Id)">
                                <input type="radio" name="_kg" value="@kg.Id" />
                                <div class="kg-time">@kg.GioBatDau.ToString("hh\\:mm") – @kg.GioKetThuc.ToString("hh\\:mm")</div>
                                <div class="kg-gia">@kg.Gia.ToString("N0")đ</div>
                            </label>
                        }
                    }
                </div>
            </div>

            <!-- Lý do -->
            <div style="margin-bottom:4px;">
                <div class="field-label">💬 Lý do đổi giờ <span style="color:#ef4444;">*</span></div>
                <textarea name="lyDo" id="lyDoTextarea" class="ycg-textarea"
                          placeholder="Nhập lý do đổi khung giờ (tối thiểu 20 ký tự)..."
                          oninput="demKyTu(this)" required></textarea>
                <div class="char-count" id="charCount">0 / 20 ký tự tối thiểu</div>
            </div>

            <button type="submit" class="ycg-btn" id="btnGui" onclick="return validateForm()">
                📤 Gửi yêu cầu đổi giờ
            </button>
        </form>
    </div>

    <div style="text-align:center;">
        <a href="/Booking/MyBookings" style="color:var(--muted);font-size:.85rem;text-decoration:none;">
            ← Quay lại lịch đặt
        </a>
    </div>
</div>

@section Scripts {
<script>
var _sanId = @(san?.Id ?? 0);
var _khungGioHienTaiId = @(don?.KhungGioId ?? 0);

function chonKhungGio(el, id) {
    document.querySelectorAll('.kg-item').forEach(function(e) { e.classList.remove('selected'); });
    el.classList.add('selected');
    document.getElementById('khungGioMoiInput').value = id;
}

function demKyTu(el) {
    var len = el.value.trim().length;
    var cc = document.getElementById('charCount');
    if (len >= 20) {
        cc.textContent = len + ' ký tự ✓';
        cc.className = 'char-count ok';
    } else {
        cc.textContent = len + ' / 20 ký tự tối thiểu';
        cc.className = 'char-count';
    }
}

function validateForm() {
    var kgId = document.getElementById('khungGioMoiInput').value;
    if (!kgId) { alert('Vui lòng chọn khung giờ mới!'); return false; }
    var lyDo = document.getElementById('lyDoTextarea').value.trim();
    if (lyDo.length < 20) { alert('Lý do phải ít nhất 20 ký tự!'); return false; }
    return true;
}

function loadKhungGio() {
    var ngay = document.getElementById('ngayMoiInput').value;
    if (!ngay || !_sanId) return;
    var container = document.getElementById('khungGioContainer');
    container.innerHTML = '<div style="color:var(--muted);font-size:.85rem;padding:8px 0;">Đang tải...</div>';
    document.getElementById('khungGioMoiInput').value = '';
    fetch('/Booking/KhungGioTrong?sanId=' + _sanId + '&ngay=' + ngay + '&khungGioHienTaiId=' + _khungGioHienTaiId)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data || !data.length) {
                container.innerHTML = '<div style="color:var(--muted);font-size:.88rem;padding:12px 0;">Không có khung giờ trống cho ngày này.</div>';
                return;
            }
            var html = '';
            data.forEach(function(kg) {
                html += '<label class="kg-item" onclick="chonKhungGio(this,' + kg.id + ')">' +
                    '<input type="radio" name="_kg" value="' + kg.id + '" />' +
                    '<div class="kg-time">' + kg.gioBatDau + ' – ' + kg.gioKetThuc + '</div>' +
                    '<div class="kg-gia">' + kg.gia + 'đ</div></label>';
            });
            container.innerHTML = html;
        })
        .catch(function() {
            container.innerHTML = '<div style="color:#ef4444;font-size:.85rem;">Lỗi tải dữ liệu.</div>';
        });
}
</script>
}
