@{
    ViewData["Title"] = "Chọn sân thi đấu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ghep = ViewBag.GhepTran as Web_Stadium.EFCore.GhepTran;
    var sanList = ViewBag.SanList as List<Web_Stadium.EFCore.SanBong> ?? new();
    var donA = ghep?.DatSanA;
    var donB = ghep?.DatSanB;
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Ghép trận</div>
        <h1 style="font-style:italic;line-height:0.9;margin:0">
            CHỌN SÂN<br><span class="text-green">THI ĐẤU</span>
        </h1>
    </div>
</div>

<div class="container py-4" style="max-width:800px">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">❌ @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- 2 đội đã ghép -->
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="section-card p-3" style="border:1px solid var(--green);height:100%">
                <div style="font-size:10px;color:var(--green);letter-spacing:1px;margin-bottom:8px">🅰️ ĐỘI A — @ghep?.UserA?.HoTen</div>
                <div style="font-size:14px;font-weight:600">@donA?.KhungGio?.SanBong?.TenSan</div>
                <div style="font-size:12px;color:var(--muted);margin-top:2px">📍 @donA?.KhungGio?.SanBong?.DiaChi</div>
                <div style="font-size:13px;margin-top:4px">
                    🕐 @donA?.KhungGio?.GioBatDau.ToString("HH:mm") – @donA?.KhungGio?.GioKetThuc.ToString("HH:mm")
                </div>
                <div style="font-size:12px;color:var(--green);margin-top:2px">📅 @donA?.NgayThiDau.ToString("dd/MM/yyyy")</div>
                <div style="font-size:12px;margin-top:2px">💰 @donA?.TienCoc.ToString("N0")đ cọc</div>
            </div>
        </div>
        <div class="col-md-2 d-flex align-items-center justify-content-center">
            <div style="font-size:2rem;color:var(--muted)">🆚</div>
        </div>
        <div class="col-md-5">
            <div class="section-card p-3" style="border:1px solid #3b82f6;height:100%">
                <div style="font-size:10px;color:#3b82f6;letter-spacing:1px;margin-bottom:8px">🅱️ ĐỘI B — @donB?.User?.HoTen</div>
                <div style="font-size:14px;font-weight:600">@donB?.KhungGio?.SanBong?.TenSan</div>
                <div style="font-size:12px;color:var(--muted);margin-top:2px">📍 @donB?.KhungGio?.SanBong?.DiaChi</div>
                <div style="font-size:13px;margin-top:4px">
                    🕐 @donB?.KhungGio?.GioBatDau.ToString("HH:mm") – @donB?.KhungGio?.GioKetThuc.ToString("HH:mm")
                </div>
                <div style="font-size:12px;color:#3b82f6;margin-top:2px">📅 @donB?.NgayThiDau.ToString("dd/MM/yyyy")</div>
                <div style="font-size:12px;margin-top:2px">💰 @donB?.TienCoc.ToString("N0")đ cọc</div>
            </div>
        </div>
    </div>

    <div style="font-size:13px;color:var(--muted);margin-bottom:20px;text-align:center">
        Chọn địa điểm thi đấu chung. Đơn của đội không được chọn sẽ bị hủy và hoàn cọc.
    </div>

    <!-- 3 lựa chọn -->
    <div class="row g-3 mb-4" id="optionCards">

        <!-- Option A -->
        <div class="col-md-4">
            <div class="option-card" id="opt-SanA" onclick="chonOption('SanA')"
                 style="border:2px solid var(--border);border-radius:14px;padding:20px;cursor:pointer;transition:.2s;text-align:center">
                <div style="font-size:2rem;margin-bottom:8px">🅰️</div>
                <div style="font-size:14px;font-weight:700;margin-bottom:4px">Đá tại Sân A</div>
                <div style="font-size:12px;color:var(--muted)">@donA?.KhungGio?.SanBong?.TenSan</div>
                <div style="font-size:11px;color:#ef4444;margin-top:8px">Đội B hủy đơn của họ</div>
            </div>
        </div>

        <!-- Option B -->
        <div class="col-md-4">
            <div class="option-card" id="opt-SanB" onclick="chonOption('SanB')"
                 style="border:2px solid var(--border);border-radius:14px;padding:20px;cursor:pointer;transition:.2s;text-align:center">
                <div style="font-size:2rem;margin-bottom:8px">🅱️</div>
                <div style="font-size:14px;font-weight:700;margin-bottom:4px">Đá tại Sân B</div>
                <div style="font-size:12px;color:var(--muted)">@donB?.KhungGio?.SanBong?.TenSan</div>
                <div style="font-size:11px;color:#ef4444;margin-top:8px">Đội A hủy đơn của họ</div>
            </div>
        </div>

        <!-- Option Mới -->
        <div class="col-md-4">
            <div class="option-card" id="opt-SanMoi" onclick="chonOption('SanMoi')"
                 style="border:2px solid var(--border);border-radius:14px;padding:20px;cursor:pointer;transition:.2s;text-align:center">
                <div style="font-size:2rem;margin-bottom:8px">🆕</div>
                <div style="font-size:14px;font-weight:700;margin-bottom:4px">Chọn sân mới</div>
                <div style="font-size:12px;color:var(--muted)">Cả 2 đội cùng hủy đơn cũ</div>
                <div style="font-size:11px;color:#3b82f6;margin-top:8px">Đặt sân trung lập</div>
            </div>
        </div>
    </div>

    <!-- Picker sân mới (ẩn ban đầu) -->
    <div id="sanMoiPicker" style="display:none" class="section-card p-3 mb-4">
        <div style="font-size:11px;color:var(--muted);letter-spacing:1px;margin-bottom:12px">🏟️ CHỌN SÂN TRUNG LẬP</div>
        <div style="display:flex;flex-direction:column;gap:8px" id="sanPickerList">
            @foreach (var san in sanList)
            {
                <div class="san-pick-item" data-san-id="@san.Id"
                     onclick="chonSanMoi(@san.Id)"
                     style="border:1px solid var(--border);border-radius:8px;padding:12px;cursor:pointer;transition:.2s">
                    <div style="display:flex;justify-content:space-between;align-items:center">
                        <div>
                            <strong style="font-size:14px">@san.TenSan</strong>
                            <div style="font-size:12px;color:var(--muted);margin-top:2px">📍 @san.DiaChi</div>
                        </div>
                        <div id="sanStatus-@san.Id" style="font-size:11px;color:var(--muted)">
                            <span class="spinner-border spinner-border-sm"></span>
                        </div>
                    </div>
                    <div id="sanSlots-@san.Id" style="display:none;margin-top:10px;border-top:1px solid var(--border);padding-top:8px"></div>
                </div>
            }
        </div>
    </div>

    <!-- Form submit -->
    <form method="post" action="/Booking/ChonSanGhep" id="formChon">
        <input type="hidden" name="ghepTranId" value="@ghep?.Id" />
        <input type="hidden" name="hinhThuc" id="hidHinhThuc" value="" />
        <input type="hidden" name="sanMoiId" id="hidSanMoiId" value="" />
        <input type="hidden" name="khungGioMoiId" id="hidKhungGioMoiId" value="" />

        <div id="formErrMsg" style="color:#ef4444;font-size:13px;margin-bottom:12px;display:none"></div>

        <div style="display:flex;gap:10px">
            <button type="submit" id="btnXacNhan" class="btn btn-success rounded-pill px-4" disabled>
                ✅ Xác nhận ghép trận
            </button>
            <a href="/Booking/LoiMoiGhepTran" class="btn btn-outline-secondary rounded-pill">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    var selectedOption = null;
    var selectedSanMoiId = null;
    var selectedKhungGioId = null;
    var slotsLoaded = {};

    function chonOption(opt) {
        selectedOption = opt;
        document.querySelectorAll('.option-card').forEach(function(el) {
            el.style.borderColor = 'var(--border)';
            el.style.background = '';
        });
        var card = document.getElementById('opt-' + opt);
        card.style.borderColor = 'var(--green)';
        card.style.background = 'rgba(16,185,129,.07)';

        document.getElementById('hidHinhThuc').value = opt;

        if (opt === 'SanMoi') {
            document.getElementById('sanMoiPicker').style.display = 'block';
            // Load slots for all venues
            @foreach (var san in sanList)
            {
                <text>if (!slotsLoaded[@san.Id]) { loadSanSlots(@san.Id); slotsLoaded[@san.Id] = true; }</text>
            }
        } else {
            document.getElementById('sanMoiPicker').style.display = 'none';
            selectedSanMoiId = null;
            selectedKhungGioId = null;
            document.getElementById('hidSanMoiId').value = '';
            document.getElementById('hidKhungGioMoiId').value = '';
        }

        validateForm();
    }

    function loadSanSlots(sanId) {
        fetch('/Booking/KhungGioTrongCuaSan?sanId=' + sanId)
            .then(r => r.json())
            .then(data => {
                var statusEl = document.getElementById('sanStatus-' + sanId);
                var slotsEl = document.getElementById('sanSlots-' + sanId);
                if (!data || data.length === 0) {
                    statusEl.innerHTML = '<span style="color:#ef4444;font-size:11px">Hết slot</span>';
                    return;
                }
                statusEl.innerHTML = '<span style="color:var(--green);font-size:11px">' + data.length + ' slot trống</span>';
                var html = '<div style="display:flex;flex-wrap:wrap;gap:6px">';
                data.forEach(function(k) {
                    html += '<div class="slot-pick" data-san-id="' + sanId + '" data-kg-id="' + k.id + '" data-gia="' + k.gia + '" ' +
                            'onclick="chonSlot(this,' + sanId + ',' + k.id + ',' + k.gia + ')" ' +
                            'style="padding:5px 10px;border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:12px;background:var(--bg3)">' +
                            k.gioBatDau.substring(0,5) + '–' + k.gioKetThuc.substring(0,5) +
                            '<span style="color:var(--green);margin-left:4px">' + parseInt(k.gia).toLocaleString('vi-VN') + 'đ</span>' +
                            '</div>';
                });
                html += '</div>';
                slotsEl.innerHTML = html;
            })
            .catch(function() {
                var el = document.getElementById('sanStatus-' + sanId);
                if (el) el.innerHTML = '<span style="color:var(--muted);font-size:11px">Lỗi</span>';
            });
    }

    function chonSanMoi(sanId) {
        document.querySelectorAll('.san-pick-item').forEach(function(el) {
            el.style.borderColor = 'var(--border)';
        });
        var el = document.querySelector('.san-pick-item[data-san-id="' + sanId + '"]');
        if (el) {
            el.style.borderColor = 'var(--green)';
            // Show slots
            document.querySelectorAll('[id^="sanSlots-"]').forEach(function(s) { s.style.display = 'none'; });
            document.getElementById('sanSlots-' + sanId).style.display = 'block';
        }
        selectedSanMoiId = sanId;
        selectedKhungGioId = null;
        document.getElementById('hidSanMoiId').value = sanId;
        document.getElementById('hidKhungGioMoiId').value = '';
        validateForm();
    }

    function chonSlot(btn, sanId, kgId, gia) {
        document.querySelectorAll('.slot-pick').forEach(function(b) {
            b.style.background = 'var(--bg3)';
            b.style.borderColor = 'var(--border)';
        });
        btn.style.background = 'rgba(16,185,129,.15)';
        btn.style.borderColor = 'var(--green)';

        selectedKhungGioId = kgId;
        document.getElementById('hidKhungGioMoiId').value = kgId;
        validateForm();
    }

    function validateForm() {
        var btn = document.getElementById('btnXacNhan');
        var err = document.getElementById('formErrMsg');
        var ok = false;
        var msg = '';

        if (!selectedOption) {
            msg = '⚠ Vui lòng chọn một hình thức thi đấu';
        } else if (selectedOption === 'SanMoi') {
            if (!selectedSanMoiId) msg = '⚠ Chọn sân trung lập';
            else if (!selectedKhungGioId) msg = '⚠ Chọn khung giờ trên sân mới';
            else ok = true;
        } else {
            ok = true;
        }

        btn.disabled = !ok;
        err.textContent = msg;
        err.style.display = msg ? 'block' : 'none';
    }
</script>
}
