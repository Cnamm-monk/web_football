<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ⚽ PitchHub.vn</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/support.css" />

    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* ── HEART DROPDOWN ─────────────────────────── */
        .heart-btn-wrap {
            position: relative;
            display: inline-flex;
            align-items: center;
        }

        .heart-nav-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 1.2rem;
            padding: 5px 9px;
            border-radius: 999px;
            transition: all .2s;
            position: relative;
            display: flex;
            align-items: center;
            line-height: 1;
        }

            .heart-nav-btn:hover {
                background: rgba(255,255,255,.15);
            }

        .heart-count-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: var(--green);
            color: #fff;
            font-size: .6rem;
            font-weight: 700;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .heart-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 300px;
            min-width: 280px;
            background: #fff;
            border: 1px solid rgba(14,168,106,.2);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(15,23,42,.15);
            z-index: 9999;
            overflow: hidden;
        }

            .heart-dropdown.open {
                display: block;
            }

        .heart-dd-header {
            padding: 12px 16px 10px;
            border-bottom: 1px solid rgba(15,23,42,.07);
            font-size: .78rem;
            font-weight: 700;
            color: var(--text);
            letter-spacing: .5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .heart-dd-header span {
                color: var(--green);
                font-size: .9rem;
            }

        .heart-dd-list {
            max-height: 300px;
            overflow-y: auto;
        }

        .heart-dd-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            text-decoration: none;
            transition: background .15s;
            border-bottom: 1px solid rgba(15,23,42,.05);
        }

            .heart-dd-item:last-child {
                border-bottom: none;
            }

            .heart-dd-item:hover {
                background: rgba(14,168,106,.06);
            }

        .heart-dd-img {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            object-fit: cover;
            background: #f0f4f8;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            border: 1px solid rgba(15,23,42,.08);
        }

            .heart-dd-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 10px;
            }

        .heart-dd-info .hd-name {
            color: var(--text);
            font-weight: 600;
            font-size: .85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 180px;
        }

        .heart-dd-info .hd-meta {
            color: var(--muted);
            font-size: .74rem;
            margin-top: 2px;
        }

        .heart-dd-info .hd-rating {
            color: #f59e0b;
            font-size: .75rem;
        }

        .heart-dd-empty {
            padding: 24px 16px;
            text-align: center;
            color: var(--muted);
            font-size: .85rem;
        }

            .heart-dd-empty i {
                font-size: 1.8rem;
                display: block;
                margin-bottom: 8px;
                opacity: .4;
            }

        .heart-dd-footer {
            padding: 10px 16px;
            border-top: 1px solid rgba(15,23,42,.07);
            text-align: center;
        }

            .heart-dd-footer a {
                color: var(--green);
                font-size: .8rem;
                font-weight: 600;
                text-decoration: none;
            }

                .heart-dd-footer a:hover {
                    text-decoration: underline;
                }

        /* ── CỘNG ĐỒNG DROPDOWN ─────────────────────── */
        .nav-dropdown { position: relative; }
        .nav-dropdown-toggle {
            display: flex; align-items: center; gap: 4px;
            cursor: pointer; text-decoration: none !important;
        }
        .nav-caret { font-size: 10px; transition: transform .25s; display: inline-block; }
        .nav-dropdown:hover .nav-caret { transform: rotate(180deg); }
        .nav-dropdown-menu {
            display: none;
            position: absolute;
            top: calc(100% + 12px);
            left: 50%;
            transform: translateX(-50%);
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,.16);
            border: 1px solid rgba(14,168,106,.18);
            min-width: 190px;
            overflow: hidden;
            z-index: 9999;
            animation: navFadeIn .2s ease;
        }
        .nav-dropdown:hover .nav-dropdown-menu { display: block; }
        .nav-dd-item {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 18px;
            color: #0f172a; text-decoration: none;
            font-size: 13px; font-weight: 600;
            transition: background .15s, color .15s;
            border-bottom: 1px solid rgba(15,23,42,.05);
        }
        .nav-dd-item:last-child { border-bottom: none; }
        .nav-dd-item:hover { background: rgba(14,168,106,.08); color: var(--green); }
        @@keyframes navFadeIn {
            from { opacity: 0; transform: translateX(-50%) translateY(-6px); }
            to   { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        /* ── NOTIFICATION BELL ────────────────────────── */
        .notif-wrapper { position: relative; display: inline-flex; align-items: center; }
        #notifDropdown {
            display: none;
            position: absolute;
            top: 42px; right: 0;
            width: 320px;
            background: #fff;
            border: 1px solid var(--border, #e2e8f0);
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,.18);
            z-index: 9999;
            overflow: hidden;
        }
        #notifList a:last-child { border-bottom: none !important; }
        @@media (max-width: 576px) {
            #notifDropdown {
                position: fixed !important;
                top: 60px !important;
                left: 8px !important;
                right: 8px !important;
                width: auto !important;
            }
        }
    </style>

</head>
<body>

    <nav class="navbar-custom">
        <div class="container nav-wrapper">

            <!-- ── LOGO ── -->
            <div class="nav-left">
                <div class="brand-wrapper">
                    <a class="nav-logo" href="/">
                        PITCH<span>HUB</span>
                        <i class="bi bi-dribbble" style="font-size:22px;color:white;"></i>
                    </a>
                </div>
            </div>

            <!-- ── MENU GIỮA ── -->
            <div class="nav-center">
                @using Web_Stadium.Controllers
                @using System.Security.Claims
                @inject IConfiguration Config
                @{
                    var token = Context.Request.Cookies["jwt"];
                    string? role = null;
                    string? userName = null;
                    if (!string.IsNullOrEmpty(token))
                    {
                        var principal = TokenHelper.DocToken(token, Config);
                        if (principal != null)
                        {
                            role = principal.FindFirst(ClaimTypes.Role)?.Value;
                            userName = principal.FindFirst(ClaimTypes.Name)?.Value;
                        }
                    }
                }
                <ul class="nav-links">
                    <li><a href="/">TRANG CHỦ</a></li>
                    <li><a href="/Venues">TÌM SÂN</a></li>

                    <!-- CỘNG ĐỒNG dropdown -->
                    <li class="nav-dropdown">
                        <a href="/Matchmaking" class="nav-dropdown-toggle"
                           onclick="return false;">
                            CỘNG ĐỒNG <span class="nav-caret">▾</span>
                        </a>
                        <div class="nav-dropdown-menu">
                            <a href="/Matchmaking" class="nav-dd-item">⚽ Tìm Đối Thủ</a>
                            <a href="/ChuyenNhuong/Index" class="nav-dd-item">🔄 Chuyển Nhượng</a>
                            @if (role == "Staff")
                            {
                                <a href="/TournamentStaff/DanhSach" class="nav-dd-item">🏆 Giải Đấu</a>
                            }
                            else
                            {
                                <a href="/TournamentPublic" class="nav-dd-item">🏆 Giải Đấu</a>
                            }
                        </div>
                    </li>

                    @if (!string.IsNullOrEmpty(role))
                    {
                        @if (role == "Admin")
                        {
                            <li><a href="/Admin">QUẢN TRỊ</a></li>
                            <li><a href="/Admin/HoSo">HỒ SƠ</a></li>
                        }
                        else if (role == "Owner")
                        {
                            <li><a href="/Owner">CHỦ SÂN</a></li>
                            <li><a href="/Owner/HoSo">HỒ SƠ</a></li>
                        }
                        else if (role == "Staff")
                        {
                            <li><a href="/Staff">NHÂN VIÊN</a></li>
                            <li><a href="/Staff/HoSo">HỒ SƠ</a></li>
                        }
                        else
                        {
                            <li><a href="/Booking/MyBookings">LỊCH ĐẶT</a></li>
                            <li><a href="/User/HoSo">HỒ SƠ</a></li>
                        }
                    }
                </ul>
            </div>

            <!-- ── ICONS PHẢI ── -->
            <div class="nav-right">
                @if (!string.IsNullOrEmpty(role))
                {
                    @if (role == "User")
                    {
                        <!-- Notification Bell -->
                        <div class="notif-wrapper">
                            <button class="heart-nav-btn" id="notifBtn" title="Thông báo" style="position:relative;">
                                <svg width="22" height="22" viewBox="0 0 24 24"
                                     fill="none" stroke="white" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                                </svg>
                                <span id="notifBadge" style="display:none;position:absolute;top:-4px;right:-4px;
                                      background:#ef4444;color:#fff;border-radius:50%;min-width:18px;height:18px;
                                      font-size:11px;font-weight:700;align-items:center;justify-content:center;
                                      padding:0 3px;border:2px solid #1a2e1a;pointer-events:none;"></span>
                            </button>
                            <div id="notifDropdown">
                                <div style="padding:12px 16px;border-bottom:1px solid var(--border,#e2e8f0);
                                            display:flex;justify-content:space-between;align-items:center;">
                                    <strong style="font-size:14px;color:var(--text,#0f172a);">🔔 Thông báo</strong>
                                    <span id="notifUnread" style="font-size:12px;color:#ef4444;font-weight:600;"></span>
                                </div>
                                <div id="notifList" style="max-height:400px;overflow-y:auto;">
                                    <div style="padding:24px;text-align:center;color:var(--muted);font-size:13px;">Đang tải...</div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Search -->
                    <a href="/Venues" class="heart-nav-btn" title="Tìm sân" style="text-decoration:none;">
                        <svg width="20" height="20" viewBox="0 0 24 24"
                             fill="none" stroke="white" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                    </a>

                    <!-- Avatar + logout -->
                    <div class="user-info-box">
                        <div class="badge">
                            @if (role == "Admin")      { <span class="text-admin">⚡@userName</span> }
                            else if (role == "Owner")  { <span class="text-owner">🏟️@userName</span> }
                            else if (role == "Staff")  { <span class="text-staff">👷@userName</span> }
                            else                       { <span class="text-user">⚽@userName</span> }
                        </div>
                        <a href="/Auth/Logout" class="btn-logout">Đăng xuất</a>
                    </div>
                }
                else
                {
                    <!-- Search (guest) -->
                    <a href="/Venues" class="heart-nav-btn" title="Tìm sân" style="text-decoration:none;">
                        <svg width="20" height="20" viewBox="0 0 24 24"
                             fill="none" stroke="white" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                    </a>

                    <div class="user-info-box" style="display:flex;align-items:center;gap:6px;">
                        <a href="/Auth/Login" class="heart-nav-btn" title="Đăng nhập" style="text-decoration:none;">
                            <svg width="20" height="20" viewBox="0 0 24 24"
                                 fill="none" stroke="white" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </a>
                        <a href="/Auth/Login" class="btn-logout"
                           style="background:var(--green);color:#fff;white-space:nowrap;">Đăng nhập</a>
                    </div>
                }
            </div>

        </div>
    </nav>

    @* Toast thông báo Success *@
    @if (TempData["Success"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index:9999;margin-top:70px">
            <div class="toast show align-items-center text-bg-success border-0">
                <div class="d-flex">
                    <div class="toast-body">✅ @TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    @* Toast thông báo Error *@
    @if (TempData["Error"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index:9999;margin-top:70px">
            <div class="toast show align-items-center text-bg-danger border-0">
                <div class="d-flex">
                    <div class="toast-body">❌ @TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }


    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true });</script>


    @* Tự động ẩn toast sau 4 giây *@
    <script>
        document.querySelectorAll('.toast').forEach(function(el) {
            setTimeout(function() { el.style.display = 'none'; }, 4000);
        });
    </script>

    @* Notification bell script cho User *@
    @if (role == "User")
    {
        <script>
        (function() {
            var notifData = [];
            var firstLoad = true;

            function esc(s) {
                return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            }

            function renderNotif() {
                var chuaDoc = notifData.filter(function(n){ return !n.daDoc; }).length;
                var badge = document.getElementById('notifBadge');
                if (badge) {
                    if (chuaDoc > 0) {
                        badge.textContent = chuaDoc > 9 ? '9+' : chuaDoc;
                        badge.style.display = 'flex';
                    } else {
                        badge.style.display = 'none';
                    }
                }
                var unreadEl = document.getElementById('notifUnread');
                if (unreadEl) unreadEl.textContent = chuaDoc > 0 ? chuaDoc + ' chưa đọc' : '';

                var list = document.getElementById('notifList');
                if (!list) return;
                if (!notifData.length) {
                    list.innerHTML = '<div style="padding:28px;text-align:center;color:var(--muted);font-size:13px;">Không có thông báo nào</div>';
                    return;
                }
                var icons = { GhepTran: '⚽', DoiGio: '🕐', DoiSan: '🏟️' };
                list.innerHTML = notifData.map(function(n) {
                    var icon = icons[n.loai] || '🔔';
                    var bgNew = 'rgba(14,168,106,.06)';
                    var bgHov = 'rgba(14,168,106,.12)';
                    var bg    = n.daDoc ? 'transparent' : bgNew;
                    return '<a href="' + esc(n.url) + '" '
                        + 'style="display:block;padding:12px 16px;border-bottom:1px solid var(--border,#e2e8f0);'
                        + 'background:' + bg + ';text-decoration:none;color:var(--text,#0f172a);transition:background .15s;" '
                        + 'onmouseenter="this.style.background=\'' + bgHov + '\'" '
                        + 'onmouseleave="this.style.background=\'' + bg + '\'">'
                        + '<div style="display:flex;gap:10px;align-items:flex-start;">'
                        + '<div style="font-size:1.15rem;line-height:1.5;flex-shrink:0;">' + icon + '</div>'
                        + '<div style="flex:1;min-width:0;">'
                        + '<div style="font-weight:' + (n.daDoc ? '400' : '600') + ';font-size:13px;">' + esc(n.tieuDe) + '</div>'
                        + '<div style="font-size:12px;color:var(--muted);margin-top:2px;white-space:normal;">' + esc(n.moTa) + '</div>'
                        + '<div style="font-size:11px;color:#94a3b8;margin-top:3px;">' + esc(n.thoiGian) + '</div>'
                        + '</div>'
                        + (n.daDoc ? '' : '<div style="width:8px;height:8px;border-radius:50%;background:#ef4444;margin-top:5px;flex-shrink:0;"></div>')
                        + '</div></a>';
                }).join('');
            }

            function showToast(chuaDoc) {
                if (!chuaDoc || sessionStorage.getItem('notifToastSeen')) return;
                sessionStorage.setItem('notifToastSeen', '1');
                var wrap = document.createElement('div');
                wrap.style.cssText = 'position:fixed;top:76px;right:16px;z-index:10000;max-width:320px;';
                wrap.innerHTML = '<div style="background:#fff;border:1px solid rgba(14,168,106,.3);border-radius:14px;'
                    + 'box-shadow:0 6px 24px rgba(0,0,0,.14);padding:14px 16px;display:flex;align-items:flex-start;gap:12px;">'
                    + '<div style="font-size:1.4rem;line-height:1;">🔔</div>'
                    + '<div style="flex:1;">'
                    + '<div style="font-weight:700;font-size:.9rem;color:#0f172a;margin-bottom:4px;">Bạn có <span style="color:#ef4444;">'
                    + chuaDoc + '</span> thông báo mới!</div>'
                    + '<a href="/Booking/LoiMoiGhepTran" style="color:#0EA86A;font-size:.82rem;font-weight:600;text-decoration:none;">Xem ngay →</a>'
                    + '</div>'
                    + '<button onclick="this.closest(\'[style*=fixed]\').remove()" '
                    + 'style="background:none;border:none;font-size:1.1rem;cursor:pointer;color:#94a3b8;padding:0;line-height:1;">✕</button>'
                    + '</div>';
                document.body.appendChild(wrap);
                setTimeout(function() { if (wrap.parentNode) wrap.remove(); }, 7000);
            }

            function loadThongBao() {
                fetch('/Booking/LayThongBao')
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        notifData = data || [];
                        renderNotif();
                        if (firstLoad) {
                            firstLoad = false;
                            var chuaDoc = notifData.filter(function(n){ return !n.daDoc; }).length;
                            showToast(chuaDoc);
                        }
                    })
                    .catch(function() {});
            }

            // Toggle dropdown
            var btn = document.getElementById('notifBtn');
            if (btn) {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    var dd = document.getElementById('notifDropdown');
                    if (!dd) return;
                    var open = dd.style.display !== 'none';
                    dd.style.display = open ? 'none' : 'block';
                    if (!open) loadThongBao();
                });
            }

            // Close on outside click
            document.addEventListener('click', function(e) {
                var wrapper = document.querySelector('.notif-wrapper');
                if (wrapper && !wrapper.contains(e.target)) {
                    var dd = document.getElementById('notifDropdown');
                    if (dd) dd.style.display = 'none';
                }
            });

            // Initial load + polling every 30s
            loadThongBao();
            setInterval(loadThongBao, 30000);
        })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ════ FOOTER ════ -->
    <footer class="footer-premium">
        <div class="container">

            <div class="row g-5">

                <!-- Brand -->
                <div class="col-lg-4">
                    <div class="footer-brand">
                        <h3 class="mb-3">
                            <span class="text-green">PITCH</span><span style="color:#fff">HUB</span>
                        </h3>

                        <p class="footer-desc">
                            Nền tảng đặt sân bóng hiện đại giúp người chơi
                            kết nối, đặt sân và tìm đối thủ nhanh chóng trên
                            toàn quốc.
                        </p>

                        <div class="footer-socials mt-4">
                            <a href="#"><i class="bi bi-facebook"></i></a>
                            <a href="#"><i class="bi bi-instagram"></i></a>
                            <a href="#"><i class="bi bi-youtube"></i></a>
                            <a href="#"><i class="bi bi-tiktok"></i></a>
                        </div>
                    </div>
                </div>

                <!-- Liên kết -->
                <div class="col-lg-2 col-md-4">
                    <h5 class="footer-title">Khám phá</h5>

                    <ul class="footer-links">
                        <li><a href="/Venues">Danh sách sân</a></li>
                        <li><a href="/Matchmaking">Tìm đối thủ</a></li>
                        <li><a href="/Booking/MyBookings">Lịch đặt</a></li>
                        <li><a href="/Auth/Register">Đăng ký</a></li>
                    </ul>
                </div>

                <!-- Hỗ trợ -->
                <div class="col-lg-3 col-md-4">
                    <h5 class="footer-title">Hỗ trợ</h5>

                    <ul class="footer-links">
                        <li><a href="/Support">Trung tâm hỗ trợ</a></li>
                        <li><a href="/Support/Terms">Điều khoản</a></li>
