@{
    ViewData["Title"] = "Xác thực tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var returnUrl = ViewBag.ReturnUrl as string ?? "/Venues";
    var sdtHienCo = ViewBag.SoDienThoai as string;
    var userEmail = ViewBag.UserEmail as string ?? "";
}

@section Styles {
    <style>
        .otp-wrap {
            max-width: 440px;
            margin: 120px auto 60px;
            padding: 0 16px;
        }

        .otp-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 20px;
            padding: 36px 32px;
        }

        .otp-icon {
            font-size: 3rem;
            text-align: center;
            margin-bottom: 16px;
        }

        .otp-title {
            text-align: center;
            color: var(--text);
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .otp-sub {
            text-align: center;
            color: var(--muted);
            font-size: .85rem;
            line-height: 1.6;
            margin-bottom: 28px;
        }

        .otp-label {
            color: var(--muted);
            font-size: .82rem;
            margin-bottom: 6px;
            font-weight: 500;
        }

        .otp-input {
            width: 100%;
            background: var(--bg3);
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 1rem;
            transition: border-color .2s;
            box-sizing: border-box;
        }

            .otp-input:focus {
                outline: none;
                border-color: var(--green);
            }

            .otp-input::placeholder {
                color: var(--muted2);
            }

        /* 6 ô OTP */
        .otp-digits-wrap {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin: 6px 0 20px;
        }

        .otp-digit {
            width: 48px;
            height: 56px;
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 12px;
            color: var(--text);
            font-size: 1.4rem;
            font-weight: 700;
            text-align: center;
            transition: border-color .2s;
        }

            .otp-digit:focus {
                outline: none;
                border-color: var(--green);
            }

        .btn-otp {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 12px;
            background: var(--green);
            color: #000;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: opacity .2s;
            margin-top: 6px;
        }

            .btn-otp:hover {
                opacity: .88;
            }

            .btn-otp:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

        .btn-ghost {
            width: 100%;
            padding: 11px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: transparent;
            color: var(--muted);
            font-size: .9rem;
            cursor: pointer;
            transition: all .2s;
            margin-top: 8px;
        }

            .btn-ghost:hover {
                border-color: var(--green);
                color: var(--green);
            }

        .step {
            display: none;
        }

            .step.active {
                display: block;
            }

        /* Email hint box */
        .email-hint {
            background: rgba(30,215,96,.08);
            border: 1px solid rgba(30,215,96,.2);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 16px;
            font-size: .82rem;
            color: var(--muted);
            text-align: center;
        }

            .email-hint strong {
                color: var(--green);
            }

        .countdown-otp {
            color: var(--muted);
            font-size: .8rem;
            text-align: center;
            margin-top: 10px;
        }

            .countdown-otp span {
                color: #ef4444;
                font-weight: 700;
            }

        .alert-err {
            background: rgba(239,68,68,.1);
            border: 1px solid rgba(239,68,68,.3);
            border-radius: 10px;
            padding: 10px 14px;
            color: #ef4444;
            font-size: .83rem;
            margin-bottom: 16px;
            text-align: center;
            display: none;
        }
    </style>
}

<div class="otp-wrap">
    <div class="otp-card">

        <!-- STEP 1: Nhập SĐT -->
        <div class="step active" id="step1">
            <div class="otp-icon">📧</div>
            <div class="otp-title">Xác thực tài khoản</div>
            <div class="otp-sub">
                Bước này chỉ thực hiện <strong style="color:var(--text);">một lần duy nhất</strong>.<br>
                Nhập số điện thoại, hệ thống sẽ gửi mã OTP 6 số đến <strong style="color:var(--green);">email đăng ký</strong> của bạn.
            </div>

            <div id="alertErr1" class="alert-err"></div>

            <div class="otp-label">Số điện thoại của bạn</div>
            <input type="tel" id="inputSdt" class="otp-input"
                   placeholder="0912 345 678"
                   value="@(sdtHienCo ?? "")"
                   maxlength="11" />
            <div style="height:16px;"></div>

            <button class="btn-otp" id="btnGuiOtp" onclick="guiOtp()">
                Gửi mã OTP → Email của bạn
            </button>
        </div>

        <!-- STEP 2: Nhập mã OTP -->
        <div class="step" id="step2">
            <div class="otp-icon">📧</div>
            <div class="otp-title">Nhập mã OTP</div>
            <div class="otp-sub">
                Mã 6 số đã được gửi đến email của bạn
            </div>

            <!-- Email hint -->
            <div class="email-hint">
                📬 Kiểm tra hộp thư <strong id="emailHint">@userEmail</strong><br>
                <span style="font-size:.75rem;">(Kiểm tra cả mục Spam nếu không thấy)</span>
            </div>

            <div id="alertErr2" class="alert-err"></div>

            <form method="post" action="/Otp/XacNhan" id="formXacNhan">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <input type="hidden" name="maOtp" id="hiddenOtp" value="" />

                <div class="otp-digits-wrap">
                    @for (int i = 0; i < 6; i++)
                    {
                        <input type="text" class="otp-digit"
                               maxlength="1"
                               inputmode="numeric"
                               pattern="[0-9]"
                               id="otp@i" />
                    }
                </div>

                <button type="submit" class="btn-otp" id="btnXacNhan" style="display:none">
                    ✅ Xác nhận
                </button>
            </form>

            <div class="countdown-otp">
                Mã hết hạn sau <span id="cdOtp">05:00</span>
            </div>

            <button class="btn-ghost" id="btnGuiLai" disabled onclick="guiLai()">
                Gửi lại mã (chờ <span id="cdResend">60</span>s)
            </button>

            <button class="btn-ghost" onclick="quayLaiStep1()">
                ← Đổi số điện thoại
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        var otpTimer, resendTimer;

        // ── STEP 1: Gửi OTP ──────────────────────────────────────────
        async function guiOtp() {
            var sdt = document.getElementById('inputSdt').value.trim();
            if (!sdt || sdt.replace(/\D/g,'').length < 9) {
                showErr('alertErr1', 'Vui lòng nhập số điện thoại hợp lệ!');
                return;
            }

            var btn = document.getElementById('btnGuiOtp');
            btn.disabled = true;
            btn.textContent = 'Đang gửi...';
            hideErr('alertErr1');

            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                var res = await fetch('/Otp/GuiOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'soDienThoai=' + encodeURIComponent(sdt)
                        + '&returnUrl=' + encodeURIComponent('@returnUrl')
                        + '&__RequestVerificationToken=' + encodeURIComponent(token)
                });
                var data = await res.json();

                if (data.ok) {
                    // Hiện step 2
                    document.getElementById('step1').classList.remove('active');
                    document.getElementById('step2').classList.add('active');

                    // Cập nhật email hint nếu có
                    if (data.emailHint) {
                        document.getElementById('emailHint').textContent = data.emailHint;
                    }

                    startCountdown();
                    startResendCountdown();
                    document.getElementById('d0').focus();
                } else {
                    showErr('alertErr1', data.message || 'Có lỗi xảy ra, vui lòng thử lại.');
                    btn.disabled = false;
                    btn.textContent = 'Gửi mã OTP → Email của bạn';
                }
            } catch(e) {
                showErr('alertErr1', 'Không kết nối được server. Vui lòng thử lại.');
                btn.disabled = false;
                btn.textContent = 'Gửi mã OTP → Email của bạn';
            }
        }

        // ── Nhập từng ký tự OTP ──────────────────────────────────────
        const inputs = document.querySelectorAll('.otp-digit');

        inputs.forEach((input, index) => {
            input.addEventListener('keypress', (e) => {
                if (!/[0-9]/.test(e.key)) e.preventDefault();
            });

            input.addEventListener('input', (e) => {
                input.value = input.value.replace(/[^0-9]/g, '').slice(-1);
                if (input.value && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
                updateOtp();
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && index > 0) {
                    inputs[index - 1].focus();
                    inputs[index - 1].value = '';
                    updateOtp();
                }
            });

            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const paste = (e.clipboardData || window.clipboardData)
                    .getData('text').replace(/[^0-9]/g, '');
                paste.split('').forEach((char, i) => {
                    if (inputs[i]) inputs[i].value = char;
                });
                const last = Math.min(paste.length, inputs.length) - 1;
                if (last >= 0) inputs[last].focus();
                updateOtp();
            });
        });

        function updateOtp() {
            const val = Array.from(inputs).map(i => i.value).join('');
            document.getElementById('hiddenOtp').value = val;
            const btn = document.getElementById('btnXacNhan');
            if (val.length === 6) {
                btn.style.display = 'block';
                btn.disabled = false;
            } else {
                btn.style.display = 'none';
            }
        }

        // ── Countdown 5 phút ─────────────────────────────────────────
        function startCountdown() {
            var conLai = 300;
            clearInterval(otpTimer);
            otpTimer = setInterval(function() {
                conLai--;
                var m = Math.floor(conLai / 60);
                var s = conLai % 60;
                var el = document.getElementById('cdOtp');
                if (el) el.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
                if (conLai <= 0) {
                    clearInterval(otpTimer);
                    if (el) el.textContent = 'Hết hạn';
                    var expBtn = document.getElementById('btnXacNhan');
                    expBtn.style.display = 'none';
                    expBtn.disabled = true;
                }
            }, 1000);
        }

        // ── Countdown nút gửi lại (60s) ──────────────────────────────
        function startResendCountdown() {
            var conLai = 60;
            var btnGuiLai  = document.getElementById('btnGuiLai');
            var cdResend   = document.getElementById('cdResend');
            btnGuiLai.disabled = true;
            clearInterval(resendTimer);
            resendTimer = setInterval(function() {
                conLai--;
                if (cdResend) cdResend.textContent = conLai;
                if (conLai <= 0) {
                    clearInterval(resendTimer);
                    btnGuiLai.disabled = false;
                    btnGuiLai.textContent = 'Gửi lại mã OTP';
                }
            }, 1000);
        }

        // ── Gửi lại OTP ──────────────────────────────────────────────
        function guiLai() {
            quayLaiStep1();
            setTimeout(function() { guiOtp(); }, 100);
        }

        function quayLaiStep1() {
            clearInterval(otpTimer);
            clearInterval(resendTimer);
            document.getElementById('step2').classList.remove('active');
            document.getElementById('step1').classList.add('active');
            var btn = document.getElementById('btnGuiOtp');
            btn.disabled = false;
            btn.textContent = 'Gửi mã OTP → Email của bạn';
            inputs.forEach(function(inp) { inp.value = ''; });
            document.getElementById('hiddenOtp').value = '';
            var btn = document.getElementById('btnXacNhan');
            btn.style.display = 'none';
            hideErr('alertErr2');
        }

        // ── Enter gửi form ────────────────────────────────────────────
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                var step1 = document.getElementById('step1');
                var step2 = document.getElementById('step2');
                if (step1.classList.contains('active')) guiOtp();
                if (step2.classList.contains('active') && !document.getElementById('btnXacNhan').disabled) {
                    document.getElementById('formXacNhan').submit();
                }
            }
        });

        // ── Helper ───────────────────────────────────────────────────
        function showErr(id, msg) {
            var el = document.getElementById(id);
            if (el) { el.textContent = msg; el.style.display = 'block'; }
        }
        function hideErr(id) {
            var el = document.getElementById(id);
            if (el) el.style.display = 'none';
        }
    </script>
}
