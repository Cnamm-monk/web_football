@model List<Web_Stadium.EFCore.YeuCauDoiGio>
@{
    ViewData["Title"] = "Giám sát yêu cầu đổi giờ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var filterTT = ViewBag.FilterTT as string;
    string BadgeColor(string t) => t switch {
        "ChoXuLy" => "#f59e0b", "DaPheDuyet" => "#22c55e", "TuChoi" => "#ef4444", _ => "#888"
    };
    string BadgeText(string t) => t switch {
        "ChoXuLy" => "Chờ xử lý", "DaPheDuyet" => "Đã phê duyệt", "TuChoi" => "Từ chối", _ => t
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0" style="color:#fff;">🔄 Giám sát yêu cầu đổi giờ</h4>
    <div class="d-flex gap-2">
        <a href="/Admin/YeuCauDoiGio" class="btn btn-sm @(filterTT == null ? "btn-secondary" : "btn-outline-secondary") rounded-pill">Tất cả</a>
        <a href="/Admin/YeuCauDoiGio?trangThai=ChoXuLy" class="btn btn-sm @(filterTT == "ChoXuLy" ? "btn-warning" : "btn-outline-warning") rounded-pill">Chờ xử lý</a>
        <a href="/Admin/YeuCauDoiGio?trangThai=DaPheDuyet" class="btn btn-sm @(filterTT == "DaPheDuyet" ? "btn-success" : "btn-outline-success") rounded-pill">Đã phê duyệt</a>
        <a href="/Admin/YeuCauDoiGio?trangThai=TuChoi" class="btn btn-sm @(filterTT == "TuChoi" ? "btn-danger" : "btn-outline-danger") rounded-pill">Từ chối</a>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">✅ @TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">⚠️ @TempData["Error"]</div> }

@if (!Model.Any())
{
    <div class="card bg-dark text-center p-5">
        <div style="font-size:3rem;margin-bottom:12px;">📭</div>
        <div style="color:#888;">Không có yêu cầu nào.</div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle" style="font-size:.87rem;">
            <thead>
                <tr>
                    <th>ID</th><th>Khách hàng</th><th>Sân</th><th>Đơn</th>
                    <th>Giờ cũ</th><th>Giờ mới</th><th>Ngày mới</th>
                    <th>Staff</th><th>Owner</th><th>Trạng thái</th><th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var yc in Model)
                {
                    var don = yc.DatSan;
                    var kgCu = don?.KhungGio;
                    var kgMoi = yc.KhungGioMoi;
                    <tr>
                        <td style="color:#888;">#@yc.Id</td>
                        <td>
                            <div style="font-weight:600;color:#fff;">@don?.User?.HoTen</div>
                            <div style="font-size:.75rem;color:#888;">@don?.User?.SoDienThoai</div>
                        </td>
                        <td style="color:#ccc;">@kgCu?.SanBong?.TenSan</td>
                        <td><span style="font-family:monospace;color:#1ed760;font-size:.8rem;">@don?.MaXacNhan</span></td>
                        <td style="color:#ccc;">@(kgCu != null ? $"{kgCu.GioBatDau:hh\\:mm}–{kgCu.GioKetThuc:hh\\:mm}" : "N/A")</td>
                        <td style="color:#f59e0b;font-weight:600;">@(kgMoi != null ? $"{kgMoi.GioBatDau:hh\\:mm}–{kgMoi.GioKetThuc:hh\\:mm}" : "N/A")</td>
                        <td style="color:#ccc;">@yc.NgayMoi.ToString("dd/MM/yyyy")</td>
                        <td style="color:#aaa;">@(yc.StaffXuLy?.HoTen ?? "—")</td>
                        <td style="color:#aaa;">@(yc.OwnerXuLy?.HoTen ?? "—")</td>
                        <td>
                            <span style="background:@BadgeColor(yc.TrangThai);color:#000;font-size:.72rem;
                                         padding:2px 8px;border-radius:20px;font-weight:700;">
                                @BadgeText(yc.TrangThai)
                            </span>
                        </td>
                        <td>
                            @if (yc.TrangThai == "ChoXuLy")
                            {
                                <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal"
                                        data-bs-target="#modalAdmin" data-id="@yc.Id">
                                    Ghi đè
                                </button>
                            }
                            else
                            {
                                <small style="color:#555;">@yc.ThoiGianXuLy?.ToString("dd/MM HH:mm")</small>
                            }
                        </td>
                    </tr>
                    @if (!string.IsNullOrEmpty(yc.LyDo))
                    {
                        <tr style="background:rgba(255,255,255,.02);">
                            <td colspan="11" style="font-size:.78rem;color:#888;padding:4px 12px;">
                                💬 <em>@yc.LyDo</em>
                                @if (!string.IsNullOrEmpty(yc.GhiChuAdmin))
                                {
                                    <span style="margin-left:16px;color:#60a5fa;">🛡 Admin: @yc.GhiChuAdmin</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal ghi đè Admin -->
<div class="modal fade" id="modalAdmin" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border border-secondary">
            <form method="post" action="/Admin/GhiDeYeuCau">
                @Html.AntiForgeryToken()
                <input type="hidden" name="yeuCauId" id="modalYeuCauId" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">🛡 Ghi đè Admin</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Ghi chú Admin</label>
                        <textarea name="ghiChuAdmin" class="form-control bg-dark text-white border-secondary"
                                  rows="2" placeholder="Lý do ghi đè..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="submit" name="hanhDong" value="PheDuyet" class="btn btn-success">✅ Phê duyệt</button>
                    <button type="submit" name="hanhDong" value="TuChoi" class="btn btn-danger">❌ Từ chối</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('modalAdmin').addEventListener('show.bs.modal', function(e) {
    var btn = e.relatedTarget;
    document.getElementById('modalYeuCauId').value = btn.dataset.id;
});
</script>
}
