@model List<Web_Stadium.EFCore.DatSan>
@{
    ViewData["Title"] = "Chọn đơn chuyển nhượng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container d-flex justify-content-between align-items-end">
        <div>
            <div class="section-label">Marketplace</div>
            <h1 style="font-style:italic;line-height:0.9;margin:0">
                CHỌN ĐƠN<br><span class="text-green">CHUYỂN NHƯỢNG</span>
            </h1>
        </div>
        <a href="/ChuyenNhuong/Index" class="btn btn-outline-secondary rounded-pill" style="font-size:13px">← Quay lại</a>
    </div>
</div>

<div class="container py-4" style="max-width:720px">

    <div class="alert alert-info" style="font-size:13px;border-radius:10px;margin-bottom:24px">
        💡 Chọn đơn đặt sân bạn muốn chuyển nhượng cho người khác.
        Chỉ các đơn <strong>đã xác nhận</strong>, <strong>chưa diễn ra</strong>, và chưa có bài đăng mới xuất hiện tại đây.
    </div>

    @if (!Model.Any())
    {
        <div class="section-card p-4 text-center">
            <div style="font-size:3rem;margin-bottom:16px">📭</div>
            <div style="font-family:var(--ff-h);font-size:1.1rem;margin-bottom:8px">Không có đơn nào có thể chuyển nhượng</div>
            <p style="font-size:13px;color:var(--muted)">
                Đơn phải ở trạng thái <strong>Đã xác nhận</strong>, ngày thi đấu chưa qua,
                và chưa từng chuyển nhượng.
            </p>
            <a href="/Booking/MyBookings" class="btn btn-outline-secondary rounded-pill px-4" style="font-size:13px">
                Xem lịch đặt sân của tôi
            </a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var don in Model)
            {
                var san = don.KhungGio?.SanBong;
                var kg = don.KhungGio;
                var daysLeft = (don.NgayThiDau.Date - DateTime.Today).Days;
                var urgentClass = daysLeft <= 2 ? "color:#ef4444;font-weight:700" : "color:var(--green)";

                <div class="col-12">
                    <div class="section-card p-0 overflow-hidden" style="border:1px solid var(--border);border-radius:12px">
                        <div style="display:flex;align-items:stretch">
                            <!-- Left accent -->
                            <div style="width:6px;background:linear-gradient(to bottom,var(--green),#097A4E);flex-shrink:0"></div>

                            <div class="p-3" style="flex:1">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div style="font-weight:700;font-size:15px;color:var(--text)">🏟 @(san?.TenSan ?? "—")</div>
                                        <div style="font-size:12px;color:var(--muted2)">📍 @(san?.DiaChi ?? "—") — @(san?.Quan ?? "")</div>
                                    </div>
                                    <div style="text-align:right">
                                        <div style="font-size:13px;@urgentClass">
                                            @if (daysLeft == 0) { <span>Hôm nay!</span> }
                                            else if (daysLeft == 1) { <span>Ngày mai</span> }
                                            else { <span>@daysLeft ngày nữa</span> }
                                        </div>
                                        <div style="font-size:11px;color:var(--muted)">⚽ Sân @(san?.LoaiSan) người</div>
                                    </div>
                                </div>

                                <div class="d-flex gap-3 flex-wrap" style="font-size:13px;margin-bottom:10px">
                                    <span>📅 <strong style="color:var(--green)">@don.NgayThiDau.ToString("dd/MM/yyyy")</strong></span>
                                    <span>⏰ @kg?.GioBatDau.ToString("HH:mm")–@kg?.GioKetThuc.ToString("HH:mm")</span>
                                    <span>💰 Cọc: <strong>@don.TienCoc.ToString("N0") đ</strong></span>
                                </div>

                                @if (don.DatSanDichVus?.Any() == true)
                                {
                                    <div class="d-flex gap-2 flex-wrap" style="margin-bottom:10px">
                                        @foreach (var dv in don.DatSanDichVus)
                                        {
                                            <span class="badge bg-success" style="font-size:11px">@dv.DichVu?.TenDichVu</span>
                                        }
                                    </div>
                                }

                                <div class="d-flex justify-content-between align-items-center">
                                    <div style="font-size:11px;color:var(--muted)">Mã: @don.MaXacNhan</div>
                                    <a href="/ChuyenNhuong/DangBai/@don.Id"
                                       class="btn btn-success rounded-pill px-4"
                                       style="font-size:13px;font-weight:600">
                                        Chuyển nhượng đơn này →
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
