@model List<Web_Stadium.EFCore.ChuyenNhuong>
@{
    ViewData["Title"] = "Chuyển nhượng đơn đặt sân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUserId = ViewBag.CurrentUserId as int?;
    var filter = ViewBag.Filter;
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container d-flex justify-content-between align-items-end flex-wrap gap-2">
        <div>
            <div class="section-label">Marketplace</div>
            <h1 style="font-style:italic;line-height:0.9;margin:0">
                CHUYỂN NHƯỢNG<br><span class="text-green">ĐƠN ĐẶT SÂN</span>
            </h1>
        </div>
        <div style="font-size:13px;color:var(--muted)">@Model.Count bài đăng đang tìm</div>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">

        <!-- Sidebar filter -->
        <div class="col-lg-3">
            <form method="get" action="/ChuyenNhuong/Index" class="section-card p-3">
                <div style="font-size:11px;color:var(--green);letter-spacing:1px;font-weight:700;margin-bottom:14px">🔍 BỘ LỌC</div>

                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;font-weight:600">Quận</label>
                    <select name="quan" class="form-select form-select-sm" style="background:var(--bg3);border-color:var(--border);color:var(--text)">
                        <option value="">Tất cả quận</option>
                        @foreach (var q in (ViewBag.DsQuan as List<string> ?? new()))
                        {
                            <option value="@q" selected="@(filter?.quan == q ? "selected" : null)">@q</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;font-weight:600">Loại sân</label>
                    <select name="loaiSan" class="form-select form-select-sm" style="background:var(--bg3);border-color:var(--border);color:var(--text)">
                        <option value="">Tất cả</option>
                        <option value="5" selected="@(filter?.loaiSan == "5" ? "selected" : null)">Sân 5 người</option>
                        <option value="7" selected="@(filter?.loaiSan == "7" ? "selected" : null)">Sân 7 người</option>
                        <option value="11" selected="@(filter?.loaiSan == "11" ? "selected" : null)">Sân 11 người</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;font-weight:600">Ngày thi đấu</label>
                    <input type="date" name="ngay" class="form-control form-control-sm"
                           value="@filter?.ngay"
                           style="background:var(--bg3);border-color:var(--border);color:var(--text)" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;font-weight:600">Giá (đ)</label>
                    <div class="d-flex gap-2">
                        <input type="number" name="giaMin" placeholder="Từ" class="form-control form-control-sm"
                               value="@filter?.giaMin"
                               style="background:var(--bg3);border-color:var(--border);color:var(--text)" />
                        <input type="number" name="giaMax" placeholder="Đến" class="form-control form-control-sm"
                               value="@filter?.giaMax"
                               style="background:var(--bg3);border-color:var(--border);color:var(--text)" />
                    </div>
                </div>

                <button type="submit" class="btn btn-success btn-sm rounded-pill w-100">Lọc kết quả</button>
                <a href="/ChuyenNhuong/Index" class="btn btn-outline-secondary btn-sm rounded-pill w-100 mt-2">Xóa bộ lọc</a>
            </form>
        </div>

        <!-- Danh sách card -->
        <div class="col-lg-9">
            @if (!Model.Any())
            {
                <div style="text-align:center;padding:80px 0;color:var(--muted)">
                    <div style="font-size:3rem;margin-bottom:16px">🏟️</div>
                    <div style="font-family:var(--ff-h);font-size:1.2rem">Chưa có bài đăng chuyển nhượng nào</div>
                    <p style="font-size:13px;margin-top:8px">Hãy là người đầu tiên đăng bài!</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var cn in Model)
                    {
                        var san = cn.DatSan?.KhungGio?.SanBong;
                        var kg = cn.DatSan?.KhungGio;
                        var elapsed = DateTime.Now - cn.ThoiGianTao;
                        var timeAgo = elapsed.TotalHours < 1 ? "Vừa đăng" : $"{(int)elapsed.TotalHours}h trước";
                        var isOwner = currentUserId.HasValue && cn.UserAId == currentUserId.Value;

                        <div class="col-md-6">
                            <div class="section-card p-0 overflow-hidden h-100" style="border:1px solid var(--border);border-radius:12px;">
                                <!-- Header sân -->
                                <div style="background:linear-gradient(135deg,var(--green),#097A4E);padding:14px 16px;">
                                    <div style="font-size:13px;font-weight:700;color:#fff">🏟 @(san?.TenSan ?? "Sân bóng")</div>
                                    <div style="font-size:12px;color:rgba(255,255,255,.8);margin-top:2px">
                                        📍 @(san?.DiaChi ?? "") — @(san?.Quan ?? "")
                                    </div>
                                </div>

                                <div class="p-3">
                                    <!-- Tiêu đề + giá -->
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div style="font-size:14px;font-weight:700;color:var(--text)">@cn.TieuDe</div>
                                        @if (cn.GiaChuyenNhuong == 0)
                                        {
                                            <span class="badge bg-success" style="font-size:11px;">MIỄN PHÍ</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background:#f59e0b;font-size:11px;">
                                                @cn.GiaChuyenNhuong.ToString("N0") đ
                                            </span>
                                        }
                                    </div>

                                    <!-- Thông tin -->
                                    <div style="font-size:12px;color:var(--muted);margin-bottom:8px">
                                        📅 @cn.DatSan?.NgayThiDau.ToString("dd/MM/yyyy") &nbsp;|&nbsp;
                                        ⏰ @kg?.GioBatDau.ToString("HH:mm")–@kg?.GioKetThuc.ToString("HH:mm") &nbsp;|&nbsp;
                                        ⚽ Sân @(san?.LoaiSan) người
                                    </div>

                                    @if (!string.IsNullOrEmpty(cn.MoTa))
                                    {
                                        <div style="font-size:12px;color:var(--muted2);font-style:italic;margin-bottom:8px;
                                                    overflow:hidden;text-overflow:ellipsis;display:-webkit-box;
                                                    -webkit-line-clamp:2;-webkit-box-orient:vertical;">
                                            "@cn.MoTa"
                                        </div>
                                    }

                                    @if (cn.GiaChuyenNhuong > 0)
                                    {
                                        <div style="font-size:11px;color:#f59e0b;background:rgba(245,158,11,.1);
                                                    padding:4px 8px;border-radius:6px;margin-bottom:8px;">
                                            ⚠️ Giao dịch tài chính thực hiện ngoài hệ thống
                                        </div>
                                    }

                                    <!-- Footer: author + nút -->
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <div style="font-size:12px;color:var(--muted)">
                                            👤 @(cn.UserA?.HoTen ?? "Ẩn danh") · @timeAgo
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/ChuyenNhuong/ChiTiet/@cn.Id"
                                               class="btn btn-sm btn-outline-success rounded-pill" style="font-size:12px;">
                                                Xem chi tiết
                                            </a>
                                            @if (isOwner)
                                            {
                                                <form method="post" action="/ChuyenNhuong/HuyBai" style="margin:0">
                                                    <input type="hidden" name="chuyenNhuongId" value="@cn.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill"
                                                            style="font-size:12px;"
                                                            onclick="return confirm('Hủy bài đăng này?')">
                                                        Hủy
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
