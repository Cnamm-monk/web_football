@model List<Web_Stadium.EFCore.ChuyenNhuong>
@{
    ViewData["Title"] = "Phê duyệt chuyển nhượng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Owner Dashboard</div>
        <h1 style="font-style:italic;line-height:0.9;margin:0">
            PHÊ DUYỆT<br><span class="text-green">CHUYỂN NHƯỢNG</span>
        </h1>
    </div>
</div>

<div class="container py-4" style="max-width:860px">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">❌ @TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:80px 0;color:var(--muted)">
            <div style="font-size:3rem;margin-bottom:16px">✅</div>
            <div style="font-family:var(--ff-h);font-size:1.1rem">Không có yêu cầu nào chờ phê duyệt</div>
        </div>
    }
    else
    {
        @foreach (var cn in Model)
        {
            var san = cn.DatSan?.KhungGio?.SanBong;
            var kg = cn.DatSan?.KhungGio;
            var diemThuong = cn.DatSan != null ? (int)(cn.DatSan.TienCoc / 1000) : 0;

            <div class="section-card p-0 overflow-hidden mb-4" style="border:1px solid var(--border);border-radius:12px">
                <!-- Header -->
                <div style="background:linear-gradient(135deg,#7c3aed,#5b21b6);padding:14px 18px;display:flex;justify-content:space-between;align-items:center">
                    <div style="color:#fff;font-weight:700;font-size:14px">🏆 #@cn.Id — @cn.TieuDe</div>
                    <span class="badge bg-primary">Chờ Owner phê duyệt</span>
                </div>

                <div class="p-4">
                    <div class="row g-3 mb-3">
                        <!-- Thông tin đơn -->
                        <div class="col-md-6">
                            <div style="font-size:11px;color:var(--green);letter-spacing:1px;margin-bottom:8px">🏟️ ĐƠN ĐẶT SÂN</div>
                            <table style="font-size:13px;width:100%">
                                <tr><td style="color:var(--muted);padding:2px 8px 2px 0;width:110px">Sân</td><td><strong>@(san?.TenSan ?? "—")</strong></td></tr>
                                <tr><td style="color:var(--muted);padding:2px 8px 2px 0">Ngày</td><td><strong style="color:var(--green)">@cn.DatSan?.NgayThiDau.ToString("dd/MM/yyyy")</strong></td></tr>
                                <tr><td style="color:var(--muted);padding:2px 8px 2px 0">Giờ</td><td>@kg?.GioBatDau.ToString("HH:mm") – @kg?.GioKetThuc.ToString("HH:mm")</td></tr>
                                <tr><td style="color:var(--muted);padding:2px 8px 2px 0">Mã xác nhận</td><td style="font-size:12px;color:var(--muted2)">@cn.DatSan?.MaXacNhan</td></tr>
                                <tr><td style="color:var(--muted);padding:2px 8px 2px 0">Tiền cọc</td><td><strong>@cn.DatSan?.TienCoc.ToString("N0") đ</strong></td></tr>
                                <tr>
                                    <td style="color:var(--muted);padding:2px 8px 2px 0">Giá CN</td>
                                    <td>
                                        @if (cn.GiaChuyenNhuong == 0)
                                        {
                                            <span class="badge bg-success">MIỄN PHÍ</span>
                                        }
                                        else
                                        {
                                            <strong style="color:#f59e0b">@cn.GiaChuyenNhuong.ToString("N0") đ (ngoài HT)</strong>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Hai bên + điểm thưởng -->
                        <div class="col-md-6">
                            <div style="font-size:11px;color:var(--green);letter-spacing:1px;margin-bottom:8px">👥 HAI BÊN GIAO DỊCH</div>
                            <div style="font-size:13px;margin-bottom:10px">
                                <div style="color:var(--muted);margin-bottom:2px">Người chuyển (A) → nhận điểm</div>
                                <strong>@(cn.UserA?.HoTen ?? "—")</strong>
                                <div style="font-size:12px;color:var(--muted2)">@cn.UserA?.Email</div>
                            </div>
                            <div style="font-size:13px;margin-bottom:12px">
                                <div style="color:var(--muted);margin-bottom:2px">Người nhận (B) → nhận đơn</div>
                                <strong>@(cn.UserB?.HoTen ?? "—")</strong>
                                <div style="font-size:12px;color:var(--muted2)">@cn.UserB?.Email</div>
                            </div>

                            <!-- Tóm tắt tác động -->
                            <div style="background:var(--bg3);border-radius:8px;padding:10px;font-size:12px">
                                <div style="font-weight:700;margin-bottom:6px;color:var(--text)">📊 Nếu phê duyệt:</div>
                                <div>• Đơn chuyển sang tên <strong>@(cn.UserB?.HoTen ?? "B")</strong></div>
                                <div>• <strong>@(cn.UserA?.HoTen ?? "A")</strong> nhận <strong style="color:var(--green)">+@diemThuong điểm</strong></div>
                                <div style="color:var(--muted);font-style:italic;margin-top:4px">
                                    (Tương đương @cn.DatSan?.TienCoc.ToString("N0") đ tiền cọc ÷ 1000)
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(cn.MoTa))
                    {
                        <div style="font-size:13px;color:var(--muted2);font-style:italic;padding:10px;background:var(--bg3);border-radius:8px;margin-bottom:12px">
                            Mô tả: "@cn.MoTa"
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(cn.GhiChuStaff))
                    {
                        <div style="font-size:12px;padding:8px 12px;background:rgba(29,78,216,.08);border-left:3px solid #1d4ed8;border-radius:6px;margin-bottom:12px">
                            <strong style="color:#1d4ed8">📝 Ghi chú Staff:</strong> @cn.GhiChuStaff
                        </div>
                    }

                    <div style="font-size:12px;color:var(--muted);margin-bottom:16px">
                        🕐 Tạo @cn.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")
                    </div>

                    <!-- Form xử lý -->
                    <form method="post" action="/Owner/XuLyChuyenNhuong">
                        <input type="hidden" name="chuyenNhuongId" value="@cn.Id" />
                        <div class="mb-3">
                            <label class="form-label" style="font-size:13px;font-weight:600">Ghi chú Owner (tùy chọn)</label>
                            <textarea name="ghiChu" class="form-control" rows="2" placeholder="Nhập ghi chú nếu cần..."
                                      style="background:var(--bg3);border-color:var(--border);color:var(--text);font-size:13px;resize:none"></textarea>
                        </div>
                        <div class="d-flex gap-3 flex-wrap">
                            <button type="submit" name="hanhDong" value="PheDuyet"
                                    class="btn btn-success rounded-pill px-4"
                                    onclick="return confirm('Phê duyệt và thực hiện chuyển nhượng đơn này?')">
                                ✅ Phê duyệt — chuyển đơn
                            </button>
                            <button type="submit" name="hanhDong" value="TuChoi"
                                    class="btn btn-danger rounded-pill px-4"
                                    onclick="return confirm('Từ chối yêu cầu chuyển nhượng này?')">
                                ❌ Từ chối
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</div>
