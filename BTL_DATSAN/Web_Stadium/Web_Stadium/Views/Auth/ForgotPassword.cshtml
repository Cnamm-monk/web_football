@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="rm-auth-wrap">
    <div class="rm-auth-container" style="max-width:480px;">
        <div class="rm-auth-side rm-left" style="flex:1;">
            <a href="/" class="rm-logo">Pitch<span>Hub</span></a>

            <h2 class="rm-title">Quên mật khẩu</h2>

            <p style="color:var(--muted);font-size:.9rem;line-height:1.6;margin-bottom:24px;">
                Tính năng đặt lại mật khẩu đang được phát triển.<br>
                Vui lòng liên hệ hỗ trợ nếu cần trợ giúp ngay.
            </p>

            <div style="background:rgba(14,168,106,.08);border:1px solid rgba(14,168,106,.2);
                        border-radius:12px;padding:16px 20px;margin-bottom:24px;">
                <div style="font-size:.82rem;color:var(--muted);margin-bottom:4px;">Liên hệ hỗ trợ</div>
                <a href="mailto:support@pitchhub.vn"
                   style="color:var(--green);font-weight:600;text-decoration:none;">
                    support@pitchhub.vn
                </a>
            </div>

            <a href="/Auth/Login" class="rm-btn rm-btn-primary"
               style="display:block;text-align:center;text-decoration:none;">
                ← Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>
