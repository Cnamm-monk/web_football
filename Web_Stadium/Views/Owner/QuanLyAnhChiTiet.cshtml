@model List<Web_Stadium.EFCore.AnhSanBong>
@{
    ViewData["Title"] = "Quản lý ảnh chi tiết";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var san = ViewBag.San as Web_Stadium.EFCore.SanBong;
}

<style>
    :root {
        --green: #0f6e4a;
        --green-bg: rgba(15,110,74,0.08);
        --green-border: rgba(15,110,74,0.2);
        --border: #e2e8f0;
        --muted: #475569;
        --bg: #f8fafc;
    }
    body { background: var(--bg); font-family: 'Inter', sans-serif; }
    .page-header { background: #fff; border-bottom: 1px solid var(--border); padding: 24px 0; }
    .sticky-nav { background: #fff; border-bottom: 1px solid var(--border); padding: 12px 0; position: sticky; top: 0; z-index: 100; }
    .nav-btn { font-size: 12px; padding: 5px 14px; border-radius: 30px; border: 1px solid var(--border); background: transparent; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .nav-btn:hover { background: var(--bg); }
    .nav-btn-active { background: var(--green-bg); color: var(--green); border-color: var(--green-border); }
    .image-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; margin-top: 1rem; }
    .image-card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .image-card img { width: 100%; height: 140px; object-fit: cover; display: block; cursor: pointer; }
    .image-info { padding: 6px 10px; display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.6); color: white; font-size: 12px; }
    .badge-primary { background: var(--green); color: white; padding: 2px 8px; border-radius: 20px; font-size: 11px; }
    .badge-secondary { background: #64748b; color: white; padding: 2px 8px; border-radius: 20px; font-size: 11px; }
    .btn-icon { background: transparent; border: none; color: white; font-size: 14px; cursor: pointer; padding: 0 3px; }
    .url-row { display: flex; gap: 8px; margin-bottom: 8px; }
    .url-row input { flex: 1; }
    .btn-remove { background: #fee2e2; border: none; color: #dc2626; border-radius: 8px; padding: 0 10px; cursor: pointer; font-size: 16px; }
    .btn-remove:hover { background: #fecaca; }
    .url-preview { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); display: none; }
</style>

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <div class="text-muted mb-1" style="font-size:11px;letter-spacing:1px;">OWNER / QUẢN LÝ ẢNH</div>
                <h1 style="font-size:2rem;font-weight:700;margin:0;">
                    Ảnh sân <span style="color:var(--green)">@san?.TenSan</span>
                </h1>
            </div>
            <a href="/Owner/QuanLyAnh" class="btn btn-outline-secondary rounded-pill">← Quay lại</a>
        </div>
    </div>
</div>

<!-- STICKY NAV -->
<div class="sticky-nav">
    <div class="container">
        <div class="d-flex gap-2 flex-wrap">
            <a href="/Owner" class="nav-btn">📊 Tổng quan</a>
            <a href="/Owner/DanhSachSan" class="nav-btn">🏟️ Danh sách sân</a>
            <a href="/Owner/DangKySan" class="nav-btn">➕ Đăng ký sân</a>
            <a href="/Owner/DanhSachDonDat" class="nav-btn">📋 Duyệt lịch</a>
            <a href="/Owner/QuanLyAnh" class="nav-btn">🖼️ Quản lý ảnh</a>
            <a href="/Owner/QuanLyAnhChiTiet?sanId=@san?.Id" class="nav-btn nav-btn-active">🖼️ Ảnh chi tiết</a>
            <a href="/Owner/QuanLyStaff" class="nav-btn">👷 Nhân viên</a>
            <a href="/Owner/BaoCao" class="nav-btn">📈 Báo cáo</a>
            <a href="/Owner/DanhSachDanhGia" class="nav-btn">⭐ Đánh giá</a>
        </div>
    </div>
</div>

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-3">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 mb-3">❌ @TempData["Error"]</div>
    }

    <!-- NHẬP URL ẢNH -->
    <div class="card shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-semibold mb-1">🔗 Thêm ảnh bằng URL</h5>
        <p class="text-muted small mb-3">Dán link ảnh từ internet · Hỗ trợ nhiều URL cùng lúc</p>

        <form method="post" action="/Owner/UploadAnhUrl">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sanId" value="@san?.Id" />

            <div id="urlList">
                <!-- Hàng URL đầu tiên -->
                <div class="url-row">
                    <img class="url-preview" src="" alt="">
                    <input type="text" name="urls" class="form-control url-input"
                           placeholder="https://example.com/anh.jpg" />
                    <button type="button" class="btn-remove" onclick="xoaHang(this)" title="Xóa">✕</button>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill"
                        onclick="themHang()">+ Thêm URL</button>
                <button type="submit" class="btn btn-success rounded-pill px-4">⬆️ Lưu tất cả</button>
            </div>
        </form>
    </div>

    <!-- GALLERY -->
    <div class="card shadow-sm rounded-4 p-4">
        <h5 class="fw-semibold mb-3">🖼️ Thư viện ảnh (@Model.Count ảnh)</h5>
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-images fa-3x mb-2 opacity-25 d-block"></i>
                <p>Chưa có ảnh nào.</p>
            </div>
        }
        else
        {
            <div class="image-grid">
                @foreach (var img in Model.OrderBy(x => x.ThuTu))
                {
                    <div class="image-card">
                        <img src="@img.DuongDan" alt="Ảnh sân" loading="lazy"
                             onclick="openLightbox('@img.DuongDan')">
                        <div class="image-info">
                            <div>
                                @if (img.ThuTu == 1)
                                {
                                    <span class="badge-primary">📌 Đại diện</span>
                                }
                                else
                                {
                                    <span class="badge-secondary">#@img.ThuTu</span>
                                }
                            </div>
                            <div>
                                <form method="post" action="/Owner/SetImagePrimaryForm" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <input type="hidden" name="sanId" value="@san?.Id" />
                                    <button type="submit" class="btn-icon" title="Đặt làm đại diện">⭐</button>
                                </form>
                                <form method="post" action="/Owner/XoaAnhForm" style="display:inline"
                                      onsubmit="return confirm('Xóa ảnh này?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@img.Id" />
                                    <input type="hidden" name="sanId" value="@san?.Id" />
                                    <button type="submit" class="btn-icon" style="color:#ff6b6b" title="Xóa">🗑️</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Lightbox -->
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark border-0 rounded-4">
            <div class="modal-body p-2 text-center">
                <img id="lightboxImg" src="" class="img-fluid rounded-3" style="max-height:85vh">
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-outline-light rounded-pill px-4"
                        data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Thêm hàng URL mới
function themHang() {
    const div = document.createElement('div');
    div.className = 'url-row';
    div.innerHTML = `
        <img class="url-preview" src="" alt="">
        <input type="text" name="urls" class="form-control url-input"
               placeholder="https://example.com/anh.jpg" />
        <button type="button" class="btn-remove" onclick="xoaHang(this)" title="Xóa">✕</button>`;
    document.getElementById('urlList').appendChild(div);
    // Gắn sự kiện preview cho input mới
    div.querySelector('.url-input').addEventListener('blur', previewUrl);
    div.querySelector('.url-input').focus();
}

// Xóa hàng URL
function xoaHang(btn) {
    const list = document.getElementById('urlList');
    if (list.children.length <= 1) {
        // Không xóa hàng cuối, chỉ xóa nội dung
        btn.closest('.url-row').querySelector('input').value = '';
        btn.closest('.url-row').querySelector('.url-preview').style.display = 'none';
        return;
    }
    btn.closest('.url-row').remove();
}

// Preview ảnh khi blur khỏi input
function previewUrl(e) {
    const input = e.target;
    const url   = input.value.trim();
    const img   = input.closest('.url-row').querySelector('.url-preview');
    if (!url) { img.style.display = 'none'; return; }
    img.src = url;
    img.style.display = 'block';
    img.onerror = () => { img.style.display = 'none'; };
}

// Gắn sự kiện preview cho hàng đầu tiên
document.querySelectorAll('.url-input').forEach(input => {
    input.addEventListener('blur', previewUrl);
});

// Lightbox
window.openLightbox = function(src) {
    document.getElementById('lightboxImg').src = src;
    new bootstrap.Modal(document.getElementById('lightboxModal')).show();
};
</script>
}
