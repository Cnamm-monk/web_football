@{
    ViewData["Title"] = "Duyệt đơn đặt sân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var donChoDuyet = ViewBag.DonChoDuyet as List<Web_Stadium.EFCore.DatSan> ?? new();
    var donDaXuLy = ViewBag.DonDaXuLy as List<Web_Stadium.EFCore.DatSan> ?? new();
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Owner — Vận hành</div>
        <h1 style="font-style:italic;line-height:0.9">
            DUYỆT ĐƠN<br>
            <span class="text-green">ĐẶT SÂN</span>
            @if (donChoDuyet.Any())
            {
                <span style="display:inline-block;background:#ef4444;color:#fff;
                                 font-size:.9rem;padding:4px 14px;border-radius:999px;
                                 vertical-align:middle;margin-left:12px;">
                    @donChoDuyet.Count chờ duyệt
                </span>
            }
        </h1>
    </div>
</div>

<div style="background:var(--bg3);border-bottom:1px solid var(--border);padding:12px 0;position:sticky;top:0;z-index:100">
    <div class="container d-flex gap-2">
        <a href="/Owner" class="btn btn-sm btn-outline-light rounded-pill">📊 Dashboard</a>
        <a href="/Owner/DuyetDon" class="btn btn-sm btn-success rounded-pill">✅ Duyệt đơn</a>
        <a href="/Owner/HoanCoc" class="btn btn-sm btn-outline-warning rounded-pill">💰 Hoàn cọc</a>
    </div>
</div>

<div class="container py-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">✅ @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">❌ @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- ĐƠN CHỜ DUYỆT -->
    <div style="font-size:11px;color:#ef4444;letter-spacing:1px;margin-bottom:14px;">
        ⏳ CHỜ DUYỆT (@donChoDuyet.Count) — Khách đã trả cọc và đang chờ xác nhận
    </div>

    @if (!donChoDuyet.Any())
    {
        <div class="section-card p-5 text-center mb-4" style="color:var(--muted)">
            <div style="font-size:3rem;margin-bottom:12px;">✅</div>
            <div>Không có đơn nào đang chờ duyệt.</div>
        </div>
    }

    @foreach (var don in donChoDuyet)
    {
        var kg = don.KhungGio;
        var san = kg?.SanBong;
        var thoiGianCho = (DateTime.Now - don.ThoiGianTao).TotalHours;
        var urgentColor = thoiGianCho > 4 ? "#ef4444" : thoiGianCho > 2 ? "#f59e0b" : "var(--green)";

        <div class="section-card p-0 overflow-hidden mb-4"
             style="border:1px solid rgba(239,68,68,.3);">

            <!-- Header -->
            <div style="background:rgba(239,68,68,.06);padding:14px 20px;
                            display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <span style="font-family:var(--ff-h);font-size:15px;color:#fff;">
                        @san?.TenSan
                    </span>
                    <span style="color:var(--muted);font-size:13px;margin-left:10px;">
                        @kg?.GioBatDau.ToString("HH:mm") – @kg?.GioKetThuc.ToString("HH:mm")
                        | @don.NgayThiDau.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <span style="color:@urgentColor;font-size:12px;font-weight:700;">
                    ⏱ Chờ @((int)thoiGianCho)h @((int)((thoiGianCho % 1) * 60))p
                    @(thoiGianCho > 5 ? "— SẮP TỰ HỦY!" : "")
                </span>
            </div>

            <!-- Thông tin khách -->
            <div style="padding:16px 20px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;font-size:13px;border-bottom:1px solid var(--border)">
                <div>
                    <div style="color:var(--muted);margin-bottom:3px;">Khách hàng</div>
                    <div style="font-weight:600;">@don.User?.HoTen</div>
                    <div style="color:var(--muted2);">@don.User?.SoDienThoai</div>
                </div>
                <div>
                    <div style="color:var(--muted);margin-bottom:3px;">Tiền cọc đã trả</div>
                    <div style="font-weight:700;color:var(--green);font-size:15px;">@don.TienCoc.ToString("N0")đ</div>
                </div>
                <div>
                    <div style="color:var(--muted);margin-bottom:3px;">Mã đơn</div>
                    <code style="color:var(--green);font-size:14px;">@don.MaXacNhan</code>
                </div>
            </div>

            <!-- Dịch vụ -->
            @if (don.DatSanDichVus?.Any() == true)
            {
                <div style="padding:10px 20px;background:rgba(0,0,0,.1);border-bottom:1px solid var(--border);font-size:12px;">
                    <span style="color:var(--muted);">Dịch vụ kèm: </span>
                    @foreach (var dv in don.DatSanDichVus)
                    {
                        <span style="margin-right:10px;color:var(--muted2);">
                            @dv.DichVu?.TenDichVu ×@dv.SoLuong
                            <span style="color:var(--green);">(@(((dv.DichVu?.Gia ?? 0) * dv.SoLuong).ToString("N0"))đ)</span>
                        </span>
                    }
                </div>
            }

            <!-- Action -->
            <div style="padding:16px 20px;display:flex;gap:10px;align-items:flex-start;flex-wrap:wrap;">

                <!-- Duyệt -->
                <form method="post" action="/Owner/XacNhanDon" style="flex-shrink:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="datSanId" value="@don.Id" />
                    <button type="submit" class="btn btn-success rounded-pill"
                            style="font-size:14px;padding:8px 20px;font-weight:700;"
                            onclick="return confirm('Xác nhận duyệt đơn @don.MaXacNhan?\nEmail + QR sẽ gửi ngay cho khách.')">
                        ✅ Duyệt — Gửi email xác nhận
                    </button>
                </form>

                <!-- Từ chối -->
                <form method="post" action="/Owner/TuChoiDon"
                      style="display:flex;gap:8px;flex:1;min-width:280px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="datSanId" value="@don.Id" />
                    <input type="text" name="lyDo" class="form-control form-control-sm"
                           placeholder="Lý do từ chối (bắt buộc)..."
                           required
                           style="background:var(--bg3);border-color:var(--border);color:#fff;font-size:13px;flex:1;" />
                    <button type="submit" class="btn btn-outline-danger rounded-pill btn-sm"
                            style="font-size:13px;white-space:nowrap;"
                            onclick="return confirm('Xác nhận từ chối? Khách sẽ được hoàn 100% cọc.')">
                        ❌ Từ chối
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- ĐÃ XỬ LÝ GẦN ĐÂY -->
    @if (donDaXuLy.Any())
    {
        <div style="font-size:11px;color:var(--muted);letter-spacing:1px;margin:28px 0 14px;">
            📋 ĐÃ XỬ LÝ GẦN ĐÂY (@donDaXuLy.Count)
        </div>
        @foreach (var don in donDaXuLy)
        {
            var isXN = don.TrangThai == "DaXacNhan";
            <div style="padding:12px 18px;border:1px solid var(--border);border-radius:10px;
                                margin-bottom:8px;display:flex;justify-content:space-between;
                                align-items:center;font-size:13px;opacity:.7;">
                <div>
                    <strong>@don.KhungGio?.SanBong?.TenSan</strong>
                    <span style="color:var(--muted);margin-left:10px;">@don.User?.HoTen</span>
                    <span style="color:var(--muted);margin-left:10px;">@don.NgayThiDau.ToString("dd/MM/yyyy")</span>
                </div>
                <span style="color:@(isXN ? "var(--green)" : "#ef4444");font-weight:700;font-size:12px;">
                    @(isXN ? "✅ Đã duyệt" : "❌ Từ chối")
                </span>
            </div>
        }
    }
</div>
