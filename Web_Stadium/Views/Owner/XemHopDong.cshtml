@model Web_Stadium.EFCore.SanBong
@{
    ViewData["Title"] = "Hợp đồng điện tử";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isPreview = ViewBag.IsPreview == true;
    var tyLeHH = ViewBag.TyLeHH ?? (Model.Id > 0 ? ViewBag.TyLeHoaHong ?? 0.10m : 0.10m);
    var tenVung = ViewBag.TenVung ?? "";
    var ownerName = ViewBag.OwnerName ?? Model.Owner?.HoTen;
    var ownerEmail = ViewBag.OwnerEmail ?? Model.Owner?.Email;
    var ownerPhone = ViewBag.OwnerPhone ?? Model.Owner?.SoDienThoai;
    var ngayKy = isPreview ? DateTime.Now : (Model.NgayKyHopDong ?? DateTime.Now);
    ViewData["ActiveNav"] = isPreview ? "DangKySan" : "DanhSachSan";
}

<style>
    :root {
        --db-bg: #f8fafc;
        --db-surface: #ffffff;
        --db-border: #e2e8f0;
        --db-muted: #475569;
        --db-text: #0f172a;
        --db-green: #0f6e4a;
        --db-green-bg: rgba(15,110,74,0.08);
        --db-green-border: rgba(15,110,74,0.2);
    }
    body { background: var(--db-bg); font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }

    .page-header { background: var(--db-surface); border-bottom: 1px solid var(--db-border); padding: 24px 0 20px; }
    .sticky-nav { background: var(--db-surface); border-bottom: 1px solid var(--db-border); padding: 12px 0; position: sticky; top: 0; z-index: 100; }
    .nav-btn {
        font-size: 12px; padding: 5px 14px; border-radius: 30px; border: 1px solid var(--db-border);
        background: transparent; color: var(--db-muted); text-decoration: none;
        display: inline-flex; align-items: center; gap: 5px; transition: 0.15s;
    }
    .nav-btn:hover { background: var(--db-bg); color: var(--db-text); border-color: #cbd5e1; }
    .nav-btn-active { background: var(--db-green-bg); color: var(--db-green); border-color: var(--db-green-border); }

    /* In ấn chỉ hiển thị nội dung hợp đồng, ẩn header, footer, nút */
    @@media print {
        .no-print, .btn, .sticky-nav, .page-header, footer, .action-buttons {
            display: none !important;
        }

        body, .container, .card {
            background: white !important;
            padding: 0 !important;
            margin: 0 !important;
            box-shadow: none !important;
            border: none !important;
        }

        .contract-content {
            width: 100%;
            font-size: 12pt;
            line-height: 1.4;
        }

            .contract-content p, .contract-content h3, .contract-content table {
                page-break-inside: avoid;
            }
    }
</style>

<div class="page-header no-print">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <div class="text-muted mb-1" style="font-size: 11px; letter-spacing: 1px;">OWNER / HỢP ĐỒNG</div>
                <h1 style="font-size: 2rem; font-weight: 700; margin: 0;">
                    @(isPreview ? "Xem trước " : "")<span style="color: var(--db-green);">hợp đồng điện tử</span>
                </h1>
                <p class="text-muted mt-2 mb-0">@Model.TenSan — @Model.Quan, @Model.ThanhPho</p>
            </div>
            <button type="button" class="btn btn-outline-secondary rounded-pill" onclick="window.print()">
                <i class="fas fa-print me-2"></i>In hợp đồng
            </button>
        </div>
    </div>
</div>

<div class="no-print">
    @await Html.PartialAsync("_OwnerNav")
</div>

<div class="container contract-content" style="max-width: 1000px; margin: 0 auto; background: white; padding: 2rem; box-shadow: 0 0 10px rgba(0,0,0,0.05);">
    <!-- Nội dung hợp đồng lấy từ file Word, đã chuyển sang HTML và thay biến động -->
    <div style="font-family: 'Times New Roman', Times, serif; font-size: 14px; line-height: 1.5;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <strong>CỘNG HOÀ XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong><br />
            Độc lập – Tự do – Hạnh phúc
        </div>
        <div style="text-align: center; margin-bottom: 2rem;">
            <strong style="font-size: 18px;">HỢP ĐỒNG HỢP TÁC KINH DOANH</strong><br />
            <em>Số: @(isPreview ? "[...]" : $"PITCHHUB/{Model.Id}/{Model.NgayKyHopDong:yyyyMMdd}")/HĐHTKD</em>
        </div>

        <p>Căn cứ vào Bộ Luật Dân Sự số 91/2015/QH13 ngày 24 tháng 11 năm 2015;</p>
        <p>Căn cứ vào Luật Thương Mại số 36/2005/QH11 ngày 14 tháng 06 năm 2005;</p>
        <p>Căn cứ vào tình hình thực tế và nhu cầu hợp tác của Hai bên;</p>
        <p>Dựa trên tinh thần trung thực và thiện chí hợp tác;</p>
        <p><strong>Chúng tôi gồm có:</strong></p>

        <p>
            <strong>BÊN A (Đơn vị vận hành nền tảng):</strong><br />
            Tên đơn vị : Công ty TNHH PitchHub Việt Nam<br />
            Địa chỉ : Thành phố Hồ Chí Minh, Việt Nam<br />
            Đại diện : Giám đốc điều hành PitchHub<br />
            Email : contact@pitchhub.vn<br />
            Điện thoại : 1800-PITCH<br />
            (Sau đây gọi tắt là Bên A)
        </p>

        <p>
            <strong>BÊN B (Chủ sân bóng):</strong><br />
            Họ và tên : @ownerName<br />
            Địa chỉ : @ownerEmail<br />
            Điện thoại : @ownerPhone<br />
            Email : @ownerEmail<br />
            (Sau đây gọi tắt là Bên B)
        </p>

        <p>Cùng thỏa thuận ký hợp đồng hợp tác kinh doanh với những điều khoản sau:</p>

        <h4 style="font-weight: bold;">Điều 1. MỤC TIÊU VÀ PHẠM VI HỢP TÁC</h4>
        <p>
            <strong>1.1. Mục tiêu hợp tác</strong><br />
            Bên A và Bên B nhất trí hợp tác kinh doanh, điều hành và chia sẻ lợi nhuận từ hoạt động cho thuê sân bóng thông qua nền tảng trực tuyến PitchHub.
        </p>
        <p>
            <strong>1.2. Phạm vi hợp tác</strong><br />
            Bên B đăng ký đưa cơ sở thể tháo "<strong>@Model.TenSan</strong>" lên hệ thống PitchHub:<br />
            - Địa chỉ sân : @Model.DiaChi, @Model.Quan, @Model.ThanhPho<br />
            - Loại sân : @Model.LoaiSan người<br />
            - Loại cỏ : @Model.LoaiCo<br />
            - Khu vực : @tenVung
        </p>
        <p>
            Phạm vi Bên A: Vận hành nền tảng đặt sân, tiếp thị, hỗ trợ thanh toán.<br />
            Phạm vi Bên B: Quản lý, vận hành cơ sở vật chất và dịch vụ tại sân.
        </p>

        <h4 style="font-weight: bold;">Điều 2. THỜI HẠN HỢP ĐỒNG</h4>
        <p>
            Thời hạn hợp đồng: 1 năm (12 tháng) kể từ ngày ký.<br />
            - Bắt đầu : @ngayKy.ToString("dd/MM/yyyy")<br />
            - Kết thúc : @ngayKy.AddYears(1).ToString("dd/MM/yyyy")<br />
            Gia hạn hợp đồng: Hết thời hạn trên, hai bên có thể thỏa thuận gia hạn thêm 12 tháng hoặc ký hợp đồng mới. Nếu không có thông báo chấm dứt trước 30 ngày, hợp đồng tự động gia hạn.
        </p>

        <h4 style="font-weight: bold;">Điều 3. PHÍ HOA HỒNG VÀ PHÂN CHIA LỢI NHUẬN</h4>
        <p>
            <strong>3.1. Tỷ lệ hoa hồng</strong><br />
            Căn cứ khu vực @Model.Quan thuộc vùng "@tenVung", tỷ lệ áp dụng:<br />
            - Bên A (PitchHub) được hưởng : @((tyLeHH * 100).ToString("F0"))% trên doanh thu thực phát sinh<br />
            - Bên B (Chủ sân) được hưởng : @((100 - tyLeHH * 100).ToString("F0"))% trên doanh thu thực phát sinh
        </p>
        <p>
            <strong>3.2. Phương thức tính</strong><br />
            - Khách hủy đặt sân: Hoa hồng Bên A = Tiền cọc đã thu × @((tyLeHH * 100).ToString("F0"))%<br />
            &nbsp;&nbsp;Bên B nhận = Tiền cọc - Hoa hồng Bên A<br />
            - Khách sử dụng đủ: Hoa hồng Bên A = Tổng tiền thuê sân × @((tyLeHH * 100).ToString("F0"))%<br />
            &nbsp;&nbsp;Bên B nhận = Tổng tiền thuê sân - Hoa hồng Bên A
        </p>
        <p>
            <strong>3.3. Thanh toán</strong><br />
            Định kỳ hàng tháng, chậm nhất ngày 10 tháng kế tiếp qua chuyển khoản ngân hàng.
        </p>

        <h4 style="font-weight: bold;">Điều 4. CÁC NGUYÊN TẮC TÀI CHÍNH</h4>
        <p>
            4.1. Hai bên tuân thủ nguyên tắc tài chính kế toán theo quy định pháp luật Cộng hoà Xã hội chủ nghĩa Việt Nam.<br />
            4.2. Mọi khoản thu chi đều được ghi chép rõ ràng, đầy đủ, xác thực.<br />
            4.3. Hệ thống PitchHub ghi nhận tự động toàn bộ giao dịch đặt sân.
        </p>

        <h4 style="font-weight: bold;">Điều 5. QUYỀN VÀ NGHĨA VỤ CỦA BÊN A</h4>
        <p>
            <strong>5.1. Quyền của Bên A</strong><br />
            - Được hưởng @((tyLeHH * 100).ToString("F0"))% hoa hồng theo Điều 3.<br />
            - Tạm ngưng hoặc gỡ sân khỏi hệ thống nếu Bên B vi phạm các điều khoản.<br />
            - Điều chỉnh tỷ lệ hoa hồng sau khi thông báo trước 30 ngày.
        </p>
        <p>
            <strong>5.2. Nghĩa vụ của Bên A</strong><br />
            - Cung cấp nền tảng đặt sân ổn định, hỗ trợ kỹ thuật 24/7.<br />
            - Quảng bá sân đến khách hàng trên toàn hệ thống.<br />
            - Thanh toán phần doanh thu sau khi trừ hoa hồng đúng hạn quy định.<br />
            - Bảo mật thông tin kinh doanh của Bên B.
        </p>

        <h4 style="font-weight: bold;">Điều 6. QUYỀN VÀ NGHĨA VỤ CỦA BÊN B</h4>
        <p>
            <strong>6.1. Quyền của Bên B</strong><br />
            - Được hưởng @((100 - tyLeHH * 100).ToString("F0"))% doanh thu sau khi trừ hoa hồng.<br />
            - Tự quản lý lịch đặt sân, khung giờ và giá thuê trên hệ thống.<br />
            - Yêu cầu hỗ trợ kỹ thuật từ Bên A khi cần thiết.
        </p>
        <p>
            <strong>6.2. Nghĩa vụ của Bên B</strong><br />
            - Cung cấp thông tin sân trung thực, đầy đủ và cập nhật kịp thời.<br />
            - Đảm bảo chất lượng cơ sở vật chất phù hợp với mô tả trên hệ thống.<br />
            - Không hủy đặt sân của khách hàng quá 3 lần/tháng không có lý do.<br />
            - Thực hiện đúng chính sách hoàn cọc theo quy định của PitchHub.<br />
            - Không tự ý liên hệ khách hàng để giao dịch ngoài hệ thống.
        </p>

        <h4 style="font-weight: bold;">Điều 7. ĐIỀU KHOẢN CHUNG</h4>
        <p>
            7.1. Hợp đồng chịu sự điều chỉnh của pháp luật Cộng hoà xã hội chủ nghĩa Việt Nam.<br />
            7.2. Bên vi phạm gây thiệt hại phải bồi thường toàn bộ và chịu phạt 8% giá trị hợp đồng bị vi phạm (trừ trường hợp bất khả kháng).<br />
            7.3. Trong quá trình thực hiện, bên có khó khăn phải thông báo cho bên kia trong vòng 30 ngày.<br />
            7.4. Mọi sửa đổi, bổ sung phải bằng văn bản và có chữ ký của hai bên.<br />
            7.5. Tranh chấp được giải quyết qua thương lượng, hoà giải; nếu không thành sẽ giải quyết tại Toà án có thẩm quyền.
        </p>

        <h4 style="font-weight: bold;">Điều 8. HIỆU LỰC HỢP ĐỒNG</h4>
        <p>
            8.1. Hợp đồng chấm dứt khi hết thời hạn tại Điều 2 hoặc theo quy định pháp luật. Khi kết thúc, hai bên lập biên bản thanh lý hợp đồng.<br />
            8.2. Hợp đồng được lập điện tử và bản cứng gồm: Có 02 (hai) bản bằng tiếng Việt, mỗi bên giữ 01 (một) bản có giá trị pháp lý như nhau.<br />
            8.3. Hợp đồng có hiệu lực kể từ ngày được Admin PitchHub phê duyệt.
        </p>

        <p style="text-align: right; margin-top: 2rem;">
            <em>@($"{Model.Quan}, ngày {ngayKy:dd} tháng {ngayKy:MM} năm {ngayKy:yyyy}")</em>
        </p>

        <div style="display: flex; justify-content: space-between; margin-top: 2rem;">
            <div style="width: 45%; text-align: center;">
                <strong>ĐẠI DIỆN BÊN A</strong><br />
                (Ký, ghi rõ họ tên, đóng dấu)<br /><br /><br />
                <strong>Công ty TNHH PitchHub</strong><br />
                <em>Giám đốc điều hành</em>
            </div>
            <div style="width: 45%; text-align: center;">
                <strong>ĐẠI DIỆN BÊN B</strong><br />
                (Ký, ghi rõ họ tên)<br /><br /><br />
                <strong>@ownerName</strong><br />
                <em>Chủ sân @Model.TenSan</em>
            </div>
        </div>

        @if (!isPreview && Model.Id > 0 && Model.DaKyHopDong)
        {
            <div class="alert alert-success mt-4">
                ✅ Hợp đồng đã được ký điện tử vào lúc @Model.NgayKyHopDong?.ToString("dd/MM/yyyy HH:mm")
            </div>
        }
        else if (isPreview)
        {
            <div class="alert alert-warning mt-4 no-print">
                ⚠️ Đây là bản <strong>xem trước</strong>. Vui lòng đọc kỹ điều khoản trước khi xác nhận.
            </div>
        }
        else
        {
            <div class="alert alert-info mt-4">
                📝 Hợp đồng sẽ được ký điện tử sau khi Admin phê duyệt.
            </div>
        }
    </div>
</div>

@if (isPreview)
{
    <div class="container no-print" style="max-width: 1000px; margin: 1.5rem auto 0;">
        <form method="post" action="/Owner/XacNhanDangKy"
              style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="daDocVaDongY" id="cbDongY" value="true" required>
                <label class="form-check-label" for="cbDongY" style="font-size: 14px;">
                    Tôi xác nhận đã đọc, hiểu và <strong>đồng ý</strong> với toàn bộ điều khoản hợp đồng trên.
                </label>
            </div>
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <a href="/Owner/DangKySan" class="btn btn-outline-secondary rounded-pill">
                    ← Sửa lại thông tin
                </a>
                <div class="d-flex gap-2">
                    <button type="submit" id="btnXacNhan" class="btn btn-success rounded-pill" disabled>
                        ✓ Đồng ý &amp; gửi Admin duyệt
                    </button>
                </div>
            </div>
        </form>
    </div>

    <script>
        // Chỉ bật nút submit khi đã tick đồng ý.
        (function () {
            var cb = document.getElementById('cbDongY');
            var btn = document.getElementById('btnXacNhan');
            if (!cb || !btn) return;
            cb.addEventListener('change', function () {
                btn.disabled = !cb.checked;
            });
        })();
    </script>
}

<div class="container text-center mt-3 no-print">
    @if (!isPreview)
    {
        <a href="/Owner/DanhSachSan" class="btn btn-outline-secondary rounded-pill">← Quay lại danh sách sân</a>
    }
</div>