@{
    ViewData["Title"] = "Hoàn cọc chủ động";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var donCoThe = ViewBag.DonCoThe as List<Web_Stadium.EFCore.DatSan> ?? new();
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Owner — Xử lý sự cố</div>
        <h1 style="font-style:italic;line-height:0.9">HOÀN CỌC<br><span class="text-green">CHỦ ĐỘNG</span></h1>
        <p style="color:var(--muted);margin-top:8px;font-size:14px;">
            Chỉ dùng khi sân có sự cố bất ngờ: ngập nước, mất điện, hỏng hóc nặng.
            Các trường hợp khác do hệ thống tự xử lý đúng chính sách.
        </p>
    </div>
</div>

<div style="background:var(--bg3);border-bottom:1px solid var(--border);padding:12px 0;position:sticky;top:0;z-index:100">
    <div class="container d-flex gap-2">
        <a href="/Owner/DuyetDon" class="btn btn-sm btn-outline-success rounded-pill">✅ Duyệt đơn</a>
        <a href="/Owner/HoanCoc" class="btn btn-sm btn-warning rounded-pill">💰 Hoàn cọc</a>
    </div>
</div>

<div class="container py-5">
    <div style="max-width:700px;margin:0 auto;">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">✅ @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">❌ @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }

        <!-- Cảnh báo -->
        <div style="background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.3);
                    border-radius:12px;padding:16px 18px;margin-bottom:24px;font-size:13px;color:#f59e0b;">
            <strong>⚠️ Lưu ý quan trọng:</strong><br>
            Chức năng này chỉ dùng khi <strong>sân có sự cố từ phía Owner</strong> như ngập nước, mất điện, hỏng hóc.
            Hủy đơn ở đây sẽ hoàn <strong>100% tiền cọc</strong> cho khách bất kể thời điểm.
            Không dùng thay cho chính sách hủy thông thường của khách — hệ thống đã tự xử lý đúng.
        </div>

        <div style="font-size:11px;color:var(--muted);letter-spacing:1px;margin-bottom:14px;">
            ĐƠN ĐÃ XÁC NHẬN — CÓ THỂ HOÀN CỌC CHỦ ĐỘNG (@donCoThe.Count)
        </div>

        @if (!donCoThe.Any())
        {
            <div class="section-card p-5 text-center" style="color:var(--muted)">
                <div style="font-size:3rem;margin-bottom:12px;">✅</div>
                <div>Không có đơn nào cần xử lý hoàn cọc chủ động.</div>
            </div>
        }

        @foreach (var don in donCoThe)
        {
            <div class="section-card p-0 overflow-hidden mb-3"
                 style="border:1px solid rgba(245,158,11,.3);">
                <div style="padding:14px 18px;border-bottom:1px solid var(--border);
                                display:flex;justify-content:space-between;align-items:center;">
                    <div>
                        <strong>@don.KhungGio?.SanBong?.TenSan</strong>
                        <span style="color:var(--muted);font-size:13px;margin-left:8px;">
                            @don.KhungGio?.GioBatDau.ToString("HH:mm")–@don.KhungGio?.GioKetThuc.ToString("HH:mm")
                            | @don.NgayThiDau.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                    <span style="color:var(--green);font-size:12px;font-weight:700;">Đã xác nhận</span>
                </div>
                <div style="padding:12px 18px;font-size:13px;border-bottom:1px solid var(--border);">
                    <span style="color:var(--muted);">Khách: </span>
                    <strong>@don.User?.HoTen</strong>
                    <span style="color:var(--muted);margin-left:12px;">SĐT: @don.User?.SoDienThoai</span>
                    <span style="color:var(--muted);margin-left:12px;">Cọc: </span>
                    <strong style="color:var(--green);">@don.TienCoc.ToString("N0")đ</strong>
                </div>
                <form method="post" action="/Owner/ThucHienHoanCoc"
                      style="padding:14px 18px;display:flex;gap:10px;align-items:center;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="datSanId" value="@don.Id" />
                    <input type="text" name="lyDo" class="form-control form-control-sm"
                           placeholder="Lý do hoàn cọc (ngập nước, mất điện...)"
                           required
                           style="background:var(--bg3);border-color:var(--border);color:#fff;font-size:13px;flex:1;" />
                    <button type="submit" class="btn btn-warning rounded-pill btn-sm"
                            style="font-size:13px;white-space:nowrap;font-weight:700;"
                            onclick="return confirm('Xác nhận hoàn 100% cọc (@don.TienCoc.ToString("N0")đ) cho khách?')">
                        💰 Hoàn 100% cọc
                    </button>
                </form>
            </div>
        }
    </div>
</div>
