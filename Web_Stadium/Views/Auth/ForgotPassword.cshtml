@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="rm-auth-wrap">
    <div class="rm-auth-container">

        <div class="rm-auth-side rm-left" style="max-width:420px;margin:auto">
            <a href="/" class="rm-logo">Pitch<span>Hub</span></a>

            <h2 class="rm-title">Quên mật khẩu</h2>
            <p style="color:var(--muted);font-size:14px;margin-bottom:24px">
                Nhập email đã đăng ký. Nếu tài khoản tồn tại, bạn sẽ được chuyển đến trang đặt lại mật khẩu.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="auth-error">
                    <span>⚠</span> @ViewBag.Error
                </div>
            }

            <form method="post" action="/Auth/ForgotPassword" class="rm-form">
                <div class="rm-input-group">
                    <input class="rm-input" type="email" name="email"
                           placeholder="Email đã đăng ký" required autocomplete="email" />
                </div>
                <button type="submit" class="rm-btn rm-btn-primary">Tiếp tục</button>
            </form>

            <div class="rm-helper-links" style="justify-content:center;margin-top:20px">
                <a href="/Auth/Login" class="rm-link-text">← Quay lại đăng nhập</a>
            </div>
        </div>

        <div class="rm-vertical-divider"></div>

        <div class="rm-auth-side rm-right">
            <h2 class="rm-title" style="color:var(--green)">Lấy lại tài khoản</h2>
            <div class="rm-steps-container">
                <div class="rm-step-card">
                    <div class="step-badge">1</div>
                    <div class="step-info">
                        <span class="step-name">Nhập email</span>
                        <span class="step-sub">Email bạn dùng để đăng ký</span>
                    </div>
                </div>
                <div class="rm-step-card">
                    <div class="step-badge">2</div>
                    <div class="step-info">
                        <span class="step-name">Đặt mật khẩu mới</span>
                        <span class="step-sub">Tối thiểu 6 ký tự</span>
                    </div>
                </div>
                <div class="rm-step-card">
                    <div class="step-badge">3</div>
                    <div class="step-info">
                        <span class="step-name">Đăng nhập lại</span>
                        <span class="step-sub">Dùng mật khẩu vừa đặt</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
