@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="rm-auth-wrap">
    <div class="rm-auth-container">

        <div class="rm-auth-side rm-left" style="max-width:420px;margin:auto">
            <a href="/" class="rm-logo">Pitch<span>Hub</span></a>

            <h2 class="rm-title">Đặt mật khẩu mới</h2>
            <p style="color:var(--muted);font-size:14px;margin-bottom:8px">
                Tài khoản: <strong style="color:var(--text)">@ViewBag.Email</strong>
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="auth-error">
                    <span>⚠</span> @ViewBag.Error
                </div>
            }

            <form method="post" action="/Auth/ResetPassword" class="rm-form" id="resetForm">
                <input type="hidden" name="email" value="@ViewBag.Email" />

                <div class="rm-input-group">
                    <input class="rm-input" type="password" name="matKhauMoi" id="pwNew"
                           placeholder="Mật khẩu mới (tối thiểu 6 ký tự)"
                           minlength="6" required />
                </div>

                <div class="rm-input-group">
                    <input class="rm-input" type="password" id="pwConfirm"
                           placeholder="Xác nhận mật khẩu mới" required />
                </div>

                <div id="pwStrength" style="height:4px;border-radius:4px;margin-bottom:12px;
                     background:var(--border);transition:.3s"></div>

                <input type="hidden" name="xacNhan" id="xacNhanInput" />

                <button type="submit" class="rm-btn rm-btn-primary">Lưu mật khẩu</button>
            </form>

            <div class="rm-helper-links" style="justify-content:center;margin-top:20px">
                <a href="/Auth/Login" class="rm-link-text">← Quay lại đăng nhập</a>
            </div>
        </div>

        <div class="rm-vertical-divider"></div>

        <div class="rm-auth-side rm-right">
            <h2 class="rm-title" style="color:var(--green)">Mật khẩu mạnh là gì?</h2>
            <div class="rm-steps-container">
                <div class="rm-step-card">
                    <div class="step-badge" style="background:var(--green)">✓</div>
                    <div class="step-info">
                        <span class="step-name">Ít nhất 6 ký tự</span>
                        <span class="step-sub">Không nên dùng mật khẩu quá ngắn</span>
                    </div>
                </div>
                <div class="rm-step-card">
                    <div class="step-badge" style="background:var(--blue)">✓</div>
                    <div class="step-info">
                        <span class="step-name">Kết hợp số & chữ</span>
                        <span class="step-sub">VD: pitchhub2025!</span>
                    </div>
                </div>
                <div class="rm-step-card">
                    <div class="step-badge" style="background:var(--yellow)">✓</div>
                    <div class="step-info">
                        <span class="step-name">Không dùng thông tin cá nhân</span>
                        <span class="step-sub">Tránh ngày sinh, tên...</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        var pwNew = document.getElementById('pwNew');
        var pwConf = document.getElementById('pwConfirm');
        var bar = document.getElementById('pwStrength');
        var xacNhan = document.getElementById('xacNhanInput');

        function checkStrength(pw) {
            var score = 0;
            if (pw.length >= 6) score++;
            if (pw.length >= 10) score++;
            if (/[0-9]/.test(pw)) score++;
            if (/[^a-zA-Z0-9]/.test(pw)) score++;
            var colors = ['#EF4444','#F59E0B','#16C47F','#0EA5E9'];
            var widths = ['25%','50%','75%','100%'];
            bar.style.background = colors[score - 1] || 'var(--border)';
            bar.style.width = widths[score - 1] || '0%';
        }

        pwNew.addEventListener('input', function() { checkStrength(this.value); });

        document.getElementById('resetForm').addEventListener('submit', function(e) {
            if (pwNew.value !== pwConf.value) {
                e.preventDefault();
                alert('Mật khẩu xác nhận không khớp!');
                return;
            }
            xacNhan.value = pwConf.value;
        });
    </script>
}
