@model List<Web_Stadium.EFCore.KhieuNai>
@{
    ViewData["Title"] = "Xử lý Khiếu nại";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var filter = (string)(ViewBag.TrangThaiFilter ?? "ChoXuLy");
    int soChoXuLy = (int)(ViewBag.SoChoXuLy ?? 0);
}

@section Styles {
<style>
.kn-wrap { max-width:960px; margin:0 auto; padding:0 16px 60px; }
.kn-card {
    background:rgba(255,255,255,.04); border-radius:16px;
    border:1px solid rgba(255,255,255,.08); margin-bottom:20px; overflow:hidden;
}
.kn-card.urgent { border-color:rgba(239,68,68,.35); }
.kn-header {
    display:flex; justify-content:space-between; align-items:center;
    padding:16px 20px; border-bottom:1px solid rgba(255,255,255,.07);
}
.kn-header.urgent { background:rgba(239,68,68,.06); }
.kn-header.success { background:rgba(30,215,96,.05); }
.kn-header.muted { background:rgba(255,255,255,.02); }

.kn-badge {
    font-size:.72rem; padding:4px 12px; border-radius:999px; font-weight:700;
}
.kn-badge.cho { background:rgba(245,158,11,.2); color:#f59e0b; }
.kn-badge.hoan { background:rgba(30,215,96,.2); color:#1ed760; }
.kn-badge.tuchoi { background:rgba(100,100,100,.2); color:#aaa; }

/* Loại khiếu nại badge */
.loai-badge {
    font-size:.72rem; padding:3px 10px; border-radius:6px; font-weight:600;
}
.loai-badge.sai { background:rgba(239,68,68,.15); color:#ef4444; border:1px solid rgba(239,68,68,.3); }
.loai-badge.loi { background:rgba(99,102,241,.15); color:#818cf8; border:1px solid rgba(99,102,241,.3); }
.loai-badge.vi { background:rgba(245,158,11,.15); color:#f59e0b; border:1px solid rgba(245,158,11,.3); }
.loai-badge.khac { background:rgba(100,100,100,.15); color:#aaa; border:1px solid rgba(100,100,100,.2); }

.kn-body { padding:20px; }
.kn-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:18px; }
.kn-info-label { font-size:.75rem; color:#888; letter-spacing:1px; margin-bottom:4px; }
.kn-info-val { font-size:.9rem; color:#fff; }

.form-dark {
    background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1);
    border-radius:12px; padding:18px; margin-top:4px;
}
.inp-dark {
    width:100%; background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.12); color:#fff;
    border-radius:8px; padding:9px 13px; font-size:.88rem;
    transition:border-color .2s; box-sizing:border-box;
}
.inp-dark:focus { outline:none; border-color:var(--green); }
.btn-hoan {
    flex:1; padding:10px; border:none; border-radius:10px;
    background:var(--green); color:#000; font-weight:700; cursor:pointer;
    transition:opacity .2s; font-size:.88rem;
}
.btn-hoan:hover { opacity:.85; }
.btn-tuchoi {
    flex:1; padding:10px; border:1px solid rgba(239,68,68,.4);
    border-radius:10px; background:rgba(239,68,68,.08);
    color:#ef4444; font-weight:700; cursor:pointer; font-size:.88rem;
    transition:all .2s;
}
.btn-tuchoi:hover { background:rgba(239,68,68,.2); }

/* Tabs */
.kn-tabs { display:flex; gap:6px; margin-bottom:28px; flex-wrap:wrap; }
.kn-tab {
    padding:8px 18px; border-radius:999px; font-size:.85rem;
    text-decoration:none; border:1px solid rgba(255,255,255,.1);
    color:#888; transition:all .2s; background:rgba(255,255,255,.03);
}
.kn-tab:hover { border-color:var(--green); color:var(--green); }
.kn-tab.active { background:var(--green); color:#000; border-color:var(--green); font-weight:700; }
.kn-tab.danger { border-color:rgba(239,68,68,.4); color:#ef4444; }
.kn-tab.danger.active { background:#ef4444; color:#fff; border-color:#ef4444; }
</style>
}

<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container">
        <div class="section-label">Admin — Xử lý Leo thang</div>
        <h1 style="font-style:italic;line-height:0.9">
            KHIẾU NẠI<br><span class="text-green">& HOÀN CỌC ĐẶC BIỆT</span>
        </h1>
        <p style="color:var(--muted);margin-top:8px;font-size:14px;max-width:520px;">
            Chỉ xử lý 3 loại leo thang: Owner từ chối hoàn sai chính sách /
            Lỗi hệ thống / Chủ sân vi phạm hợp đồng.
        </p>
    </div>
</div>

<!-- NAV -->
<div style="background:var(--bg3);border-bottom:1px solid var(--border);padding:12px 0;position:sticky;top:0;z-index:100">
    <div class="container d-flex gap-2 flex-wrap justify-content-center">
        <a href="/Admin" class="btn btn-sm btn-outline-light rounded-pill">📊 Dashboard</a>
        <a href="/Admin/DuyetSan" class="btn btn-sm btn-outline-warning rounded-pill">🏟️ Duyệt sân</a>
        <a href="/Admin/QuanLySan" class="btn btn-success rounded-pill">📍 Quản lý sân</a>
        <a href="/Admin/KhieuNai" class="btn btn-sm btn-danger rounded-pill">
            ⚠️ Khiếu nại @if(soChoXuLy > 0){<span class="badge bg-light text-danger ms-1">@soChoXuLy</span>}
        </a>
        <a href="/Admin/BaoCao" class="btn btn-sm btn-outline-secondary rounded-pill">📈 Báo cáo</a>
        <a href="/Admin/AuditLog" class="btn btn-sm btn-outline-secondary rounded-pill">🛡️ Audit Log</a>
        <a href="/Admin/QuanLyUser" class="btn btn-sm btn-outline-info rounded-pill">👥 Tài khoản</a>
        <a href="/Admin/MasterData" class="btn btn-sm btn-outline-success rounded-pill">🗂️ Master Data</a>
    </div>
</div>

<div class="container py-5">
    <div class="kn-wrap">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4">
                ✅ @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- TABS -->
        <div class="kn-tabs">
            <a href="/Admin/KhieuNai?trangThai=ChoXuLy"
               class="kn-tab danger @(filter=="ChoXuLy"?"active":"")">
                ⏳ Chờ xử lý
                @if (soChoXuLy > 0) { <span style="margin-left:4px;background:#ef4444;color:#fff;padding:1px 7px;border-radius:999px;font-size:.7rem;">@soChoXuLy</span> }
            </a>
            <a href="/Admin/KhieuNai?trangThai=DaHoanCoc" class="kn-tab @(filter=="DaHoanCoc"?"active":"")">✅ Đã hoàn cọc</a>
            <a href="/Admin/KhieuNai?trangThai=TuChoi" class="kn-tab @(filter=="TuChoi"?"active":"")">❌ Từ chối</a>
            <a href="/Admin/KhieuNai?trangThai=TatCa" class="kn-tab @(filter=="TatCa"?"active":"")">📋 Tất cả</a>
        </div>

        @if (!Model.Any())
        {
            <div style="text-align:center;padding:60px 0;color:#555;">
                <div style="font-size:3rem;margin-bottom:12px;">
                    @(filter == "ChoXuLy" ? "🎉" : "📋")
                </div>
                <div style="font-size:1.1rem;">
                    @(filter == "ChoXuLy" ? "Không có khiếu nại nào đang chờ xử lý." : "Không có dữ liệu.")
                </div>
            </div>
        }

        @foreach (var kn in Model)
        {
            var headerClass = kn.TrangThai == "ChoXuLy" ? "urgent" : kn.TrangThai == "DaHoanCoc" ? "success" : "muted";
            var cardClass   = kn.TrangThai == "ChoXuLy" ? "urgent" : "";

            // Phân loại hiển thị
            string loaiText = kn.LyDo switch {
                "SaiChinhSach"   => "❌ Sai chính sách",
                "LoiHeThong"     => "🔧 Lỗi hệ thống",
                "ViPhamHopDong"  => "⚖️ Vi phạm hợp đồng",
                _                => "📝 Khác"
            };
            string loaiClass = kn.LyDo switch {
                "SaiChinhSach"   => "sai",
                "LoiHeThong"     => "loi",
                "ViPhamHopDong"  => "vi",
                _                => "khac"
            };

            <div class="kn-card @cardClass">
                <div class="kn-header @headerClass">
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                        <span style="font-family:var(--ff-h);color:#fff;font-size:.95rem;">#KN@kn.Id</span>
                        <span class="kn-badge @(kn.TrangThai=="ChoXuLy"?"cho":kn.TrangThai=="DaHoanCoc"?"hoan":"tuchoi")">
                            @(kn.TrangThai == "ChoXuLy" ? "⏳ Chờ xử lý" : kn.TrangThai == "DaHoanCoc" ? "✅ Đã hoàn" : "❌ Từ chối")
                        </span>
                        <span class="loai-badge @loaiClass">@loaiText</span>
                    </div>
                    <span style="color:#888;font-size:.78rem;">@kn.NgayGui.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <div class="kn-body">
                    <div class="kn-grid">
                        <div>
                            <div class="kn-info-label">NGƯỜI GỬI</div>
                            <div class="kn-info-val">@kn.User?.HoTen</div>
                            <div style="color:#888;font-size:.78rem;">@kn.User?.Email &nbsp;·&nbsp; @kn.User?.SoDienThoai</div>
                        </div>
                        <div>
                            <div class="kn-info-label">ĐƠN ĐẶT SÂN</div>
                            @if (kn.DatSan?.KhungGio?.SanBong != null)
                            {
                                <div class="kn-info-val">@kn.DatSan.KhungGio.SanBong.TenSan</div>
                                <div style="color:#888;font-size:.78rem;">
                                    @kn.DatSan.NgayThiDau.ToString("dd/MM/yyyy") &nbsp;·&nbsp;
                                    Cọc: <span style="color:var(--green);font-weight:700;">@kn.DatSan.TienCoc.ToString("N0")đ</span>
                                </div>
                            }
                        </div>
                        <div>
                            <div class="kn-info-label">LÝ DO KHIẾU NẠI</div>
                            <div class="kn-info-val" style="font-size:.85rem;">@kn.LyDo</div>
                        </div>
                        @if (kn.TrangThai != "ChoXuLy")
                        {
                            <div>
                                <div class="kn-info-label">KẾT QUẢ XỬ LÝ</div>
                                <div class="kn-info-val" style="font-size:.85rem;">
                                    Admin: @kn.AdminXuLy?.HoTen
                                    <span style="color:#888;font-size:.75rem;display:block;">@kn.NgayXuLy?.ToString("dd/MM/yyyy HH:mm")</span>
                                    @if (kn.SoTienHoan.HasValue)
                                    {
                                        <span style="color:var(--green);font-weight:700;">Hoàn @kn.SoTienHoan.Value.ToString("N0")đ</span>
                                    }
                                    @if (!string.IsNullOrEmpty(kn.GhiChuAdmin))
                                    {
                                        <span style="color:#888;font-size:.78rem;display:block;font-style:italic;">@kn.GhiChuAdmin</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @* Form xử lý — chỉ hiện khi ChoXuLy *@
                    @if (kn.TrangThai == "ChoXuLy")
                    {
                        <div class="form-dark">
                            <div style="font-size:.78rem;color:#f59e0b;letter-spacing:1px;margin-bottom:14px;">
                                ⚡ XỬ LÝ KHIẾU NẠI
                            </div>
                            <form method="post" action="/Admin/XuLyKhieuNai">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@kn.Id" />
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                                    <div>
                                        <div style="font-size:.78rem;color:#888;margin-bottom:6px;">Số tiền hoàn (đ)</div>
                                        <input type="number" name="soTienHoan" class="inp-dark"
                                               value="@(kn.DatSan?.TienCoc)"
                                               placeholder="Nhập số tiền hoàn..." />
                                    </div>
                                    <div>
                                        <div style="font-size:.78rem;color:#888;margin-bottom:6px;">Ghi chú lý do xử lý</div>
                                        <input type="text" name="ghiChu" class="inp-dark"
                                               placeholder="VD: Sân sự cố, hoàn đủ theo chính sách..." />
                                    </div>
                                </div>
                                <div style="display:flex;gap:10px;">
                                    <button type="submit" name="ketQua" value="DaHoanCoc"
                                            class="btn-hoan"
                                            onclick="return confirm('Xác nhận hoàn cọc cho @kn.User?.HoTen?\nEmail thông báo sẽ được gửi ngay.')">
                                        ✅ Hoàn cọc & Gửi email
                                    </button>
                                    <button type="submit" name="ketQua" value="TuChoi"
                                            class="btn-tuchoi"
                                            onclick="return confirm('Từ chối khiếu nại này?\nEmail thông báo sẽ được gửi cho khách.')">
                                        ❌ Từ chối
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
