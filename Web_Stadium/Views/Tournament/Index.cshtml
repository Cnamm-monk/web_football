@model List<Web_Stadium.EFCore.GiaiDau>
@{
    ViewData["Title"] = "Quản lý giải đấu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .tcard {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            overflow: hidden;
            transition: box-shadow .2s, transform .2s;
            height: 100%;
        }

            .tcard:hover {
                box-shadow: var(--shadow-hover);
                transform: translateY(-3px);
            }

        .tcard-header {
            padding: 20px 22px 16px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(135deg, rgba(14,168,106,.04), transparent);
        }

        .tcard-body {
            padding: 18px 22px;
        }

        .tcard-footer {
            padding: 14px 22px;
            border-top: 1px solid var(--border);
            background: var(--bg3);
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }

        .tstate {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 4px 12px;
            border-radius: 999px;
        }

        .ts-draft {
            background: rgba(15,23,42,.08);
            color: var(--muted);
        }

        .ts-approved {
            background: rgba(14,168,106,.12);
            color: var(--green);
        }

        .ts-open {
            background: rgba(14,165,233,.12);
            color: #0EA5E9;
        }

        .ts-closed {
            background: rgba(245,158,11,.12);
            color: #F59E0B;
        }

        .ts-active {
            background: rgba(14,168,106,.18);
            color: var(--green);
            box-shadow: 0 0 0 2px rgba(14,168,106,.2);
        }

        .ts-finished {
            background: rgba(15,23,42,.06);
            color: var(--muted2);
        }

        .prog-bar {
            height: 5px;
            border-radius: 4px;
            background: var(--bg3);
            overflow: hidden;
        }

        .prog-fill {
            height: 100%;
            border-radius: 4px;
            background: var(--green);
            transition: width .4s ease;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            padding: 6px 0;
            border-bottom: 1px solid var(--border);
        }

            .stat-row:last-child {
                border-bottom: none;
            }

        .stat-lbl {
            color: var(--muted);
        }

        .stat-val {
            font-weight: 700;
            color: var(--text);
        }
    </style>
}

<!-- HEADER -->
<div style="background:var(--bg2);padding:100px 0 36px;border-bottom:1px solid var(--border)">
    <div class="container d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <div class="section-label">Owner — Giải đấu cộng đồng</div>
            <h1 style="font-style:italic;line-height:.9;margin:0">
                GIẢI ĐẤU<br><span class="text-green">CỦA TÔI</span>
            </h1>
            <p style="color:var(--muted);margin-top:8px;">
                @Model.Count giải &nbsp;·&nbsp;
                @Model.Count(g => g.TrangThai == "Active") đang diễn ra
            </p>
        </div>
        <a href="/Tournament/Create" class="btn-primary-glow">➕ Tạo giải mới</a>
    </div>
</div>

<!-- NAV -->
<div style="background:var(--bg3);border-bottom:1px solid var(--border);padding:12px 0;position:sticky;top:0;z-index:100">
    <div class="container d-flex gap-2 flex-wrap justify-content-center">
        <a href="/Owner" class="btn btn-outline-success rounded-pill">📊 Tổng quan</a>
        <a href="/Tournament" class="btn btn-outline-dark rounded-pill">🏆 Giải đấu</a>
        <a href="/Owner/DanhSachSan" class="btn btn-outline-green rounded-pill">🏟️ Danh sách sân</a>
        <a href="/Owner/DangKySan" class="btn btn-outline-warning rounded-pill">➕ Đăng ký sân mới</a>
        <a href="/Owner/QuanLyStaff" class="btn btn-outline-info rounded-pill">👷 Nhân viên</a>
        <a href="/Owner/BaoCao" class="btn btn-outline-primary rounded-pill">📈 Báo cáo</a>
    </div>
</div

<div class="container py-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:80px 0">
            <div style="font-size:4rem;margin-bottom:16px">🏆</div>
            <div style="font-family:var(--ff-h);font-size:1.5rem;margin-bottom:8px">
                Chưa có giải đấu nào
            </div>
            <p style="color:var(--muted);margin-bottom:24px">
                Tạo giải đấu đầu tiên để số hóa việc tổ chức sân bóng cộng đồng
            </p>
            <a href="/Tournament/Create" class="btn-primary-glow">🏆 Tạo giải đấu ngay</a>
        </div>
    }
    else
    {
        <!-- Filter tabs -->
        <div class="d-flex gap-2 flex-wrap mb-4">
            <button class="btn btn-sm btn-success rounded-pill filter-tab active" data-filter="all">
                Tất cả (@Model.Count)
            </button>
            @foreach (var (label, key, count) in new[]{
                ("🟢 Đang diễn ra", "Active",           Model.Count(g => g.TrangThai == "Active")),
                ("📋 Đang đăng ký", "RegistrationOpen", Model.Count(g => g.TrangThai == "RegistrationOpen")),
                ("⏳ Chờ duyệt",    "Draft",            Model.Count(g => g.TrangThai == "Draft")),
                ("✅ Đã kết thúc",  "Finished",         Model.Count(g => g.TrangThai == "Finished")),
                })
            {
                if (count > 0)
                {
                    <button class="btn btn-sm btn-outline-secondary rounded-pill filter-tab"
                            data-filter="@key">
                        @label (@count)
                    </button>
                }
            }
        </div>

        <div class="row g-4" id="giaiGrid">
            @foreach (var g in Model.OrderByDescending(x => x.ThoiGianTao))
            {
                var (stClass, stIcon) = g.TrangThai switch
                {
                    "Draft" => ("ts-draft", "⚪"),
                    "Approved" => ("ts-approved", "✅"),
                    "RegistrationOpen" => ("ts-open", "📋"),
                    "RegistrationClosed" => ("ts-closed", "🔒"),
                    "Active" => ("ts-active", "🟢"),
                    "Finished" => ("ts-finished", "🏁"),
                    _ => ("ts-draft", "⚪")
                };
                var soDoiDK = g.DoiBongs?.Count(d => d.DaThanhToan) ?? 0;
                var pctDangKy = g.SoDoiToiDa > 0 ? (int)((double)soDoiDK / g.SoDoiToiDa * 100) : 0;

                <div class="col-12 col-md-6 col-xl-4 giai-item" data-state="@g.TrangThai">
                    <div class="tcard">
                        <div class="tcard-header">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h5 style="font-family:var(--ff-h);font-size:1.1rem;
                                                   text-transform:uppercase;margin:0;line-height:1.2">
                                    @g.TenGiai
                                </h5>
                                <span class="tstate @stClass">@stIcon @g.TrangThai</span>
                            </div>
                            <div style="font-size:12px;color:var(--muted)">
                                🏟️ @g.SanBong?.TenSan &nbsp;·&nbsp;
                                📍 @g.SanBong?.Quan
                            </div>
                        </div>

                        <div class="tcard-body">
                            <!-- Tiến độ đăng ký -->
                            @if (g.TrangThai is "RegistrationOpen" or "RegistrationClosed" or "Active")
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1"
                                         style="font-size:12px;color:var(--muted)">
                                        <span>Đội đăng ký</span>
                                        <span style="font-weight:700;color:var(--text)">
                                            @soDoiDK / @g.SoDoiToiDa
                                        </span>
                                    </div>
                                    <div class="prog-bar">
                                        <div class="prog-fill" style="width:@pctDangKy%"></div>
                                    </div>
                                </div>
                            }

                            <!-- Thống kê -->
                            <div class="stat-row">
                                <span class="stat-lbl">Số bảng đấu</span>
                                <span class="stat-val">@g.SoBang bảng</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-lbl">Lệ phí / đội</span>
                                <span class="stat-val" style="color:var(--green)">
                                    @g.LePhiGiai.ToString("N0")đ
                                </span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-lbl">Ký quỹ / đội</span>
                                <span class="stat-val">@g.TienKyQuy.ToString("N0")đ</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-lbl">Thời gian</span>
                                <span class="stat-val" style="font-size:12px">
                                    @g.NgayBatDau.ToString("dd/MM") –
                                    @g.NgayKetThuc.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                            @if (g.TrangThai == "Active")
                            {
                                var soTranHom = g.TranDaus?.Count(t =>
                                t.NgayThiDau.Date == DateTime.Today) ?? 0;
                                <div class="stat-row">
                                    <span class="stat-lbl">Trận hôm nay</span>
                                    <span class="stat-val" style="color:var(--green)">
                                        @soTranHom trận
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="tcard-footer">
                            <a href="/Tournament/Details/@g.Id" class="btn-outline-green">
                                👁 Chi tiết
                            </a>
                            @if (g.TrangThai == "RegistrationClosed")
                            {
                                <a href="/Tournament/ChiaBang/@g.Id" class="btn btn-sm btn-warning rounded-pill">
                                    🎯 Chia bảng
                                </a>
                            }
                            @if (g.TrangThai is "Draft" or "Approved")
                            {
                                <form method="post" action="/Tournament/MoiDangKy/@g.Id" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill">
                                        📋 Mở đăng ký
                                    </button>
                                </form>
                            }
                            @if (g.TrangThai == "Active")
                            {
                                <a href="/Tournament/ExcelDoiSoat/@g.Id"
                                   class="btn btn-sm btn-outline-secondary rounded-pill">
                                    📊 Excel
                                </a>
                            }
                            @if (g.TrangThai == "Finished")
                            {
                                <a href="/Tournament/ExcelDoiSoat/@g.Id"
                                   class="btn btn-sm btn-success rounded-pill">
                                    📥 Tải đối soát
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Filter tabs
        document.querySelectorAll('.filter-tab').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-tab').forEach(b => {
                    b.classList.remove('active', 'btn-success');
                    b.classList.add('btn-outline-secondary');
                });
                this.classList.add('active', 'btn-success');
                this.classList.remove('btn-outline-secondary');

                var filter = this.dataset.filter;
                document.querySelectorAll('.giai-item').forEach(function(item) {
                    item.style.display = (filter === 'all' || item.dataset.state === filter)
                        ? '' : 'none';
                });
            });
        });
    </script>
}
